# Strict-by-default CI gate for {{app_name}}.
#
# Mirrors the local `pnpm verify:all` chain exactly so green-locally =>
# green-on-CI. Order matters — each gate gates the next so failures
# surface at the earliest cheap step, not the most expensive one:
#
#   1. lazuli check       — schema validation       (~5s)
#   2. lazuli doctor      — strict + coverage gate  (~20s)
#   3. lazuli generate    — Go + TS codegen         (~10s)
#   4. go build           — emitted Go compiles     (~30s)
#   5. tsc --noEmit       — emitted TS typechecks   (~20s)
#   6. lazuli test        — handler tests vs Postgres (~variable)
#
# Postgres is provided as a service container so handler tests run
# against a real database (no mocks — per CLAUDE.md test discipline).
#
# To soften any individual gate (e.g. while migrating off a baseline),
# do NOT edit this file — author a `[doctor.test_discipline.severity_override]`
# entry in Lazurite.toml with a `reason` (DOCTOR-OVERRIDE-NEEDS-REASON-001
# enforces). That way the override is reviewable per-PR.
name: CI

on:
  push:
    branches: [main]
  pull_request:

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

env:
  # Single source of truth for handler-test DB connection. Mirrors the
  # docker-compose service the README points devs at, so the test
  # harness uses the same connection string locally and on CI.
  LAZULI_TEST_DATABASE_URL: postgres://{{app_slug}}:{{app_slug}}@localhost:5432/{{app_slug}}?sslmode=disable

jobs:
  gate:
    runs-on: ubuntu-latest
    timeout-minutes: 20

    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_USER: {{app_slug}}
          POSTGRES_PASSWORD: {{app_slug}}
          POSTGRES_DB: {{app_slug}}
        ports:
          - 5432:5432
        options: >-
          --health-cmd "pg_isready -U {{app_slug}}"
          --health-interval 5s
          --health-timeout 5s
          --health-retries 10

    steps:
      - uses: actions/checkout@v4

      - name: Install Go
        uses: actions/setup-go@v5
        with:
          go-version: "1.22"
          cache: true

      - name: Install Node
        uses: actions/setup-node@v4
        with:
          node-version: "20"

      - name: Install pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 9.15.0
          run_install: false

      - name: pnpm cache
        uses: actions/cache@v4
        with:
          path: ~/.local/share/pnpm/store
          key: pnpm-${{ runner.os }}-${{ hashFiles('**/pnpm-lock.yaml') }}
          restore-keys: pnpm-${{ runner.os }}-

      - name: Install Rust toolchain (for Lazuli CLI)
        uses: dtolnay/rust-toolchain@stable

      - name: Lazuli CLI cache
        id: lazuli-cli-cache
        uses: actions/cache@v4
        with:
          path: ~/.cargo/bin/lazuli
          # Bump the suffix to bust this cache on a Lazuli CLI upgrade.
          # Pin to a specific commit / tag once Lazuli ships releases.
          key: lazuli-cli-${{ runner.os }}-v1

      - name: Install Lazuli CLI
        if: steps.lazuli-cli-cache.outputs.cache-hit != 'true'
        # TODO: pin to a release tag once Lazuli ships installable binaries.
        run: cargo install --git https://github.com/lazuli-lang/lazuli --locked lazuli_cli

      - name: pnpm install
        run: pnpm install --frozen-lockfile

      # Gate 1 — schema validation. Cheapest fast-fail.
      - name: lazuli check
        run: pnpm lazuli:check

      # Gate 2 — strict-profile doctor + per-layer coverage report.
      # `--coverage` emits machine-readable JSON to stdout; we capture
      # it to artifact for diffing across PRs.
      - name: lazuli doctor (strict + coverage)
        run: pnpm lazuli:doctor | tee doctor-report.txt

      - name: Upload doctor report
        if: always()
        uses: actions/upload-artifact@v4
        with:
          name: doctor-report
          path: doctor-report.txt
          if-no-files-found: ignore

      # Gate 3 — codegen + Go build + TS typecheck. `pnpm typecheck`
      # chains `lazuli:generate` first, so this covers both targets.
      - name: lazuli generate + go build + tsc
        run: |
          pnpm lazuli:generate
          (cd dist/go && go build ./...)
          pnpm typecheck

      # Gate 4 — handler tests against the real Postgres service.
      # Migrations are applied first so the schema matches production.
      - name: db migrate
        run: pnpm db:migrate

      - name: lazuli test (handler layer)
        run: pnpm lazuli:test
