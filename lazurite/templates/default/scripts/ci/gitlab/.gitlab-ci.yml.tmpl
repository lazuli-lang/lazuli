# Strict-by-default GitLab CI for {{app_name}}.
#
# Mirrors the local `pnpm verify:all` chain. To activate: copy this
# file to the repo root as `.gitlab-ci.yml`:
#
#   mv scripts/ci/gitlab/.gitlab-ci.yml ./.gitlab-ci.yml
#
# To soften any gate, do NOT edit this file — author a
# `[doctor.test_discipline.severity_override."<RULE>"]` entry in
# Lazurite.toml with a `reason` so the override is reviewable per-MR.

stages:
  - gate

variables:
  POSTGRES_DB: {{app_slug}}
  POSTGRES_USER: {{app_slug}}
  POSTGRES_PASSWORD: {{app_slug}}
  POSTGRES_HOST_AUTH_METHOD: trust
  LAZULI_TEST_DATABASE_URL: "postgres://{{app_slug}}:{{app_slug}}@postgres:5432/{{app_slug}}?sslmode=disable"
  PNPM_HOME: "$CI_PROJECT_DIR/.pnpm-store"

cache:
  key:
    files:
      - pnpm-lock.yaml
  paths:
    - .pnpm-store/
    - .cargo/
    - ~/.cache/go-build/

verify:
  stage: gate
  image: rust:1.82-bookworm
  timeout: 25 minutes
  services:
    - name: postgres:16
      alias: postgres

  before_script:
    # Go + Node + pnpm
    - apt-get update -qq && apt-get install -y --no-install-recommends curl ca-certificates postgresql-client
    - curl -fsSL https://go.dev/dl/go1.22.10.linux-amd64.tar.gz | tar -xzf - -C /usr/local
    - export PATH="/usr/local/go/bin:$PATH"
    - curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
    - apt-get install -y --no-install-recommends nodejs
    - corepack enable && corepack prepare pnpm@9.15.0 --activate
    # Lazuli CLI (cached via the cache: above — re-installs only on lock change)
    - if [ ! -x ~/.cargo/bin/lazuli ]; then cargo install --git https://github.com/lazuli-lang/lazuli --locked lazuli_cli; fi
    - export PATH="$HOME/.cargo/bin:$PATH"

  script:
    - pnpm install --frozen-lockfile
    - pnpm db:migrate
    # Six-step verify chain — same gates as local `pnpm verify:all`.
    - pnpm verify:all

  artifacts:
    when: always
    expire_in: 1 week
    paths:
      - doctor-report.txt
    reports:
      junit: doctor-report.txt

# CD: GitLab CI deploy stages are project-specific (Helm? Ansible? Capistrano?
# Render? Fly.io?). Add a separate `deploy` stage triggered by tag — example:
#
# deploy:
#   stage: deploy
#   only:
#     - tags
#   script:
#     - echo "wire your deploy here"
