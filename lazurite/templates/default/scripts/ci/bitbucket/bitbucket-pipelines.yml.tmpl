# Strict-by-default Bitbucket Pipelines for {{app_name}}.
#
# Mirrors the local `pnpm verify:all` chain. To activate: copy this
# file to the repo root as `bitbucket-pipelines.yml`:
#
#   mv scripts/ci/bitbucket/bitbucket-pipelines.yml ./bitbucket-pipelines.yml
#
# To soften any gate, do NOT edit this file — author a
# `[doctor.test_discipline.severity_override."<RULE>"]` entry in
# Lazurite.toml with a `reason` so the override is reviewable per-PR.
#
# Heads-up: Bitbucket Pipelines bills per build minute. This pipeline
# is sized for the strict gate (~10-15 min/run). To stay free-tier,
# scope `branches:` below or move to a self-hosted runner.

image: rust:1.82-bookworm

definitions:
  services:
    postgres:
      image: postgres:16
      variables:
        POSTGRES_DB: {{app_slug}}
        POSTGRES_USER: {{app_slug}}
        POSTGRES_PASSWORD: {{app_slug}}
        POSTGRES_HOST_AUTH_METHOD: trust

  caches:
    pnpm: $BITBUCKET_CLONE_DIR/.pnpm-store
    cargo-bin: $HOME/.cargo/bin
    go-build: $HOME/.cache/go-build

  steps:
    - step: &gate
        name: verify (strict)
        size: 2x
        services:
          - postgres
        caches:
          - pnpm
          - cargo-bin
          - go-build
        script:
          # Go + Node + pnpm
          - apt-get update -qq && apt-get install -y --no-install-recommends curl ca-certificates postgresql-client
          - curl -fsSL https://go.dev/dl/go1.22.10.linux-amd64.tar.gz | tar -xzf - -C /usr/local
          - export PATH="/usr/local/go/bin:$PATH"
          - curl -fsSL https://deb.nodesource.com/setup_20.x | bash -
          - apt-get install -y --no-install-recommends nodejs
          - corepack enable && corepack prepare pnpm@9.15.0 --activate
          # Lazuli CLI (cached — re-installs only on cache bust)
          - if [ ! -x ~/.cargo/bin/lazuli ]; then cargo install --git https://github.com/lazuli-lang/lazuli --locked lazuli_cli; fi
          - export PATH="$HOME/.cargo/bin:$PATH"
          - export LAZULI_TEST_DATABASE_URL="postgres://{{app_slug}}:{{app_slug}}@localhost:5432/{{app_slug}}?sslmode=disable"
          # Strict verify chain
          - pnpm install --frozen-lockfile
          - pnpm db:migrate
          - pnpm verify:all
        artifacts:
          - doctor-report.txt

pipelines:
  default:
    - step: *gate
  pull-requests:
    "**":
      - step: *gate

# CD: tag-triggered deploys are Bitbucket-project specific. Example:
#
# pipelines:
#   tags:
#     v*:
#       - step: *gate
#       - step:
#           name: deploy
#           deployment: production
#           script:
#             - echo "wire your deploy here"
