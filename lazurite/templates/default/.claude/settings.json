{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/lazuli-check.sh\"",
            "shell": "bash",
            "timeout": 30,
            "statusMessage": "lazuli check (edited .lzi/.lzx)..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/lazuli-gate.sh\"",
            "shell": "bash",
            "timeout": 600,
            "statusMessage": "lazuli acceptance gate (doctor + coverage)..."
          }
        ]
      }
    ]
  }
}
