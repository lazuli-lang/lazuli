feature account
  auth identity User.email
  auth password
    algorithm: argon2id
    hash @fn.hash_password
    verify @fn.verify_password
  auth sessions
    resource UserSession
    ttl "7 days"

  domain
    resource User
      email: @semantic.Email required unique
      name: Text required
      created_at: DateTime required

    resource UserSession
      user: User required
      token_hash: @cap.Hashed required
      expires_at: DateTime required
      created_at: DateTime required
