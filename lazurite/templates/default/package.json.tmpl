{
  "name": "{{app_slug}}",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "lazuli:check": "lazuli check .",
    "lazuli:doctor": "lazuli doctor .",
    "lazuli:generate": "lazuli generate go . --out dist/go && lazuli generate ts .",
    "go:build": "pnpm lazuli:generate && cd dist/go && go build ./...",
    "go:run": "pnpm lazuli:generate && dotenv -e .env -- bash -c \"cd dist/go && go build -o {{app_slug}}-api.exe . && ./{{app_slug}}-api.exe\"",
    "go:watch": "pnpm lazuli:generate && dotenv -e .env -- air",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose stop postgres",
    "db:migrate": "for f in dist/go/migrations/*.sql; do echo \"Applying $f\"; docker compose exec -T postgres psql -U {{app_slug}} -d {{app_slug}} -f - < \"$f\" || exit 1; done",
    "db:reset": "docker compose down -v postgres && pnpm db:up && sleep 3 && pnpm db:migrate",
    "stack:up": "pnpm db:up && pnpm lazuli:generate && pnpm db:migrate && pnpm go:build",
    "setup": "pnpm lazuli:generate && pnpm go:build",
    "dev": "concurrently -k -n api,web \"pnpm go:watch\" \"pnpm --filter ./app/web dev\"",
    "build": "pnpm lazuli:generate && pnpm --filter ./app/web build && pnpm go:build",
    "typecheck": "pnpm lazuli:generate && pnpm --filter ./app/web typecheck",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "concurrently": "^9.1.0",
    "dotenv-cli": "^7.4.0"
  }
}
