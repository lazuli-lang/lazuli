{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "bash tools/lazuli-hooks/lazuli-check.sh",
            "timeout": 30,
            "statusMessage": "lazuli check (edited .lzi/.lzx)..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash tools/lazuli-hooks/lazuli-gate.sh",
            "timeout": 600,
            "statusMessage": "lazuli acceptance gate (doctor + coverage)..."
          }
        ]
      }
    ]
  }
}
