# {{app_name}} env (dev defaults). Copy to `.env` and edit for stage/prod.
# All values here are safe-to-commit defaults that work with the local
# docker-compose stack out of the box.

# Postgres — consumed by docker-compose AND the Lazuli runtime (via
# LAZULI_DB below). Keep these three in sync.
POSTGRES_DB={{app_slug}}
POSTGRES_USER={{app_slug}}
POSTGRES_PASSWORD={{app_slug}}_dev_password
POSTGRES_PORT=5432

# Lazuli runtime envs (read by dist/go/main.go directly via os.Getenv).
LAZULI_ENV=local
LAZULI_DB=postgres://{{app_slug}}:{{app_slug}}_dev_password@localhost:5432/{{app_slug}}?sslmode=disable
LAZULI_ADDR=:8080

# Auth / sessions. Generate a real 256-bit secret for stage/prod:
#   openssl rand -hex 32
JWT_SIGNING_SECRET=change-me-in-prod-this-must-be-at-least-256-bits

# Object store (MinIO local; production replaces with managed S3-protocol).
# The @plugin/object-store adapter reads the S3_* vars below. To point at
# a non-MinIO provider (AWS S3, Backblaze B2, Hetzner Object Storage), set
# S3_ENDPOINT to the provider's endpoint and drop S3_FORCE_PATH_STYLE for
# AWS-native S3 (it expects virtual-hosted-style URLs).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID={{app_slug}}
S3_SECRET_ACCESS_KEY={{app_slug}}_dev_password
S3_FORCE_PATH_STYLE=true
S3_BUCKET_DEFAULT={{app_slug}}
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
