[project]
name = "{{app_name}}"
module = "{{module}}"
schema = 1

[lazuli]
runtime = "0.1.0"

[lazurite]
template = "lazurite-default"
template_version = "0.1.0"
app_dir = "app"

# Wave 3 — TDD/BDD-first defaults. Strict profile means doctor blocks
# on missing/stub tests by default. Override per-rule with a reason
# (DOCTOR-OVERRIDE-NEEDS-REASON-001 enforces non-empty reasons).
# See `docs/proposals/tdd-bdd-first-2026-05-23.md`.
[doctor]
profile = "strict"

[doctor.test_discipline]
# All test-discipline rules at default severity for strict profile.
# To override per-rule (with required `reason`):
#
#   [doctor.test_discipline.severity_override.TEST-STUB-001]
#   severity = "info"
#   reason   = "in-flight refactor 2026-06"

[generate.go]
out = "dist/go"
gofmt = true
strict = true
emit_main = true
submodule = true

[migrations]
generated = "dist/go/migrations"
manual = "migrations"
strategy = "auto"

[seeds]
dir = "seeds"
auto = false
