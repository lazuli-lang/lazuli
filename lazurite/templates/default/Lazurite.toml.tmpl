[project]
name = "{{app_name}}"
module = "{{module}}"
schema = 1

[lazuli]
runtime = "0.1.0"

# Doctor — strict security profile plus the TDD-strict coverage preset.
# `tdd-strict` blocks handler_go at 90/95 (the non-negotiable TDD pair);
# spec/actor-matrix/transition/view layers stay warn-only until you opt
# up to `preset = "tdd-mature"`. Per-layer `[doctor.coverage.<layer>]`
# sub-blocks override the preset when needed.
# See docs/canonical-semantics.md#coverage-presets.
[doctor]
profile = "strict"

[doctor.coverage]
preset = "tdd-strict"

# Knowledge — a feature draws authoring knowledge from a
# `knowledge/<sector>/` vault via `knowledge <sector>`. The core catalog
# (decisions, changes, gaps, lazuli-way) is recognized out of the box.
# Declare CUSTOM sectors here so VOCAB-KNOWLEDGE-SECTOR-UNKNOWN-001
# recognizes the slug before the folder is scaffolded (a sector is also
# known once `knowledge/<sector>/` exists on disk). Uncomment + edit:
# See docs/canonical-semantics.md#knowledge-sector.
# [knowledge.sectors]
# billing = "Revenue, invoicing, reconciliation"
# compliance = "KYC / audit / regulatory"
