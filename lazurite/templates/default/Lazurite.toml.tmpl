[project]
name = "{{app_name}}"
module = "{{module}}"
schema = 1

[lazuli]
runtime = "0.1.0"

# Doctor — strict security profile plus the TDD-strict coverage preset.
# `tdd-strict` blocks handler_go at 90/95 (the non-negotiable TDD pair);
# spec/actor-matrix/transition/view layers stay warn-only until you opt
# up to `preset = "tdd-mature"`. Per-layer `[doctor.coverage.<layer>]`
# sub-blocks override the preset when needed.
# See docs/canonical-semantics.md#coverage-presets.
[doctor]
profile = "strict"

[doctor.coverage]
preset = "tdd-strict"
