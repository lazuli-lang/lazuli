# Full Lazuli capsule sketch.
# Indentation-based design fixture, not compiler-executable yet.

feature customer
  purpose "CRM customers within an org. Tracks lifecycle status, ownership, and tier."

  non_goals
    "invoicing - see feature invoice"
    "credit scoring engine - see feature scoring"
    "user authentication - see feature user"

  domain
    enum CustomerStatus
      lead
      active
      archived

    enum CustomerTier
      free
      pro
      enterprise

    resource Customer
      org_id: Org required
      owner_id: User required
      name: Text required
      email: Email required
      status: CustomerStatus = lead
      tier: CustomerTier = free
      score: Integer = 0

      soft_delete
      timestamps

    constraints
      unique email per org_id
      index org_id, status
      index org_id, owner_id

    query list
      where
        org_id = ctx.user.org_id
        deleted_at = nil

      order created_at desc
      paginate 50

    query by_id
      params
        id: ID

      where
        id = id
        org_id = ctx.user.org_id

    query lifetime_value raw
      returns CustomerLtv[]

      params
        org_id: ID

      sql "./queries/customer_lifetime_value.sql"

    rule "archived customers cannot receive invoices"
      forbid Invoice.create where customer.status = archived
      message "Cannot invoice an archived customer"

    rule "deleted customers cannot be invoiced"
      forbid Invoice.create where customer.deleted_at != nil
      message "Cannot invoice a deleted customer"

    event customer_created
      id: ID
      org_id: ID
      email: Email

    event customer_archived
      id: ID
      by: User

    event customer_reassigned
      id: ID
      owner_id: User
      by: User

  policies
    create role_admin, role_sales
    update role_admin, role_sales
    delete role_admin
    read same_org

  command create
    input name, email, tier
    policy create
    emits customer_created

  command reassign
    input owner_id: ID
    policy update
    emits customer_reassigned

  workflow status
    archive: active -> archived
      policy update
      emits customer_archived

  surface web admin
    view list Table
      source query.list
      columns name, email, status, tier, score, created_at
      search name, email
      filter status, tier

      cells
        status ext.status_cell
        score ext.score_cell

    view detail SidePanel
      source query.by_id(id: route.id)
      block ext.activity_timeline

    view ltv_report Table
      source query.lifetime_value(org_id: ctx.user.org_id)
      columns customer_id, amount, currency

  extensions
    client status_cell: CellRenderer[Customer]
    client score_cell: CellRenderer[Customer]
    client activity_timeline: ViewBlock[Customer] at "./ui/activity_timeline.tsx"

    server before_create: Hook[CreateCustomer]
    server after_archive: Hook[ArchiveCustomer]
    server risk_score: Function[Customer, RiskScore] at "./domain/risk_score.go"
    server validate_tier: Validator[Customer.tier] at "./domain/validate_tier.go"

  escape_route "/admin/customer-imports" at "./pages/customer_imports.tsx"
