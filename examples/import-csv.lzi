# CSV import pressure test.
# Exercises file upload, batch processing, row validation, and progress UI.
# Design fixture only; parser and codegen coverage may lag this surface.

feature customer_import
  purpose "Upload CSV files, validate rows, and create customers in a background job."

  non_goals
    delegated_to
      customer: "customer lifecycle rules"
    out_of_scope
      generic_etl: "generic ETL platform"

  defaults
    policy_for jobs, webhooks: @actor.system

  uses org, user, customer

  domain
    enum ImportStatus
      uploaded
      validating
      processing
      completed
      failed

    resource ImportBatch
      tenancy org
      uploaded_by: User required
      file: @cap.File(max_size:25mb,accept:text/csv) required
      status: ImportStatus = uploaded
      total_rows: Integer = 0
      valid_rows: Integer = 0
      failed_rows: Integer = 0

      timestamps

    resource ImportRow
      tenancy org
      batch: ImportBatch required
      customer: Customer optional
      row_number: Integer required
      raw: JSON required
      error: Text optional
      validates resource @validator.row_check

      timestamps

    query.lookup by_id by id: ID

    query.list rows
      params
        batch_id: ID

      filters
        batch.id = params.batch_id

      order row_number asc
      paginate 100

    event import_uploaded
      batch_id: ID
      org_id: ID
      uploaded_by_id: ID

    event import_completed
      batch_id: ID
      valid_rows: Integer
      failed_rows: Integer

  policies
    create: @role.admin, @role.sales_ops
    read: @scope.same_org
    update: @actor.system
    delete: @role.admin

  command upload
    input file
    policy @policy.create
    rate_limit "20 per hour per user"
    creates ImportBatch
      file = input.file
      uploaded_by = ctx.user
    emits import_uploaded

  job process_batch
    trigger event import_uploaded
    queue customer_imports
    tenant_from payload.org_id
    idempotency by payload.batch_id
    retry 3 backoff exponential
    handler "./jobs/process_batch.go"
    emits import_completed

  surface web admin
    view upload Form
      submit command.upload
      fields file

    view detail SidePanel
      source query.by_id(id: route.id)
      block progress: ViewBlock[ImportBatch] at "./ui/progress.tsx"

    view rows Table
      source query.rows(batch_id: route.id)
      columns row_number, error, created_at

  extensions
    validator row_check: Validator[ImportRow] at "./domain/validate_row.go"
