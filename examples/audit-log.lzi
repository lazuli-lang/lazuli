# Audit log pressure test.
# Exercises cross-cutting event capture and query-heavy surfaces.
# Design fixture only; parser and codegen coverage may lag this surface.

feature audit_log
  purpose "Persist important domain events for compliance, support, and debugging."

  non_goals
    out_of_scope
      event_sourcing: "full event sourcing"
      analytics_warehouse: "analytics warehouse"

  defaults
    policy_for jobs, webhooks: @actor.system

  uses org, user, customer, issue, billing

  domain
    resource AuditEvent
      tenancy org
      actor: User optional
      source_feature: Text required
      source_event: Text required
      subject_type: Text required
      subject_id: ID required

      timestamps

    query.list by_subject
      params
        subject_type: Text
        subject_id: ID

      filters
        subject_type == params.subject_type
        subject_id == params.subject_id

      paginate 100

    query.list recent
      paginate 100

  policies
    create: @actor.system
    read: @role.admin, @role.support_agent
    update: @scope.none
    delete: @scope.none

  job record_customer_created
    trigger event customer.customer_created
    idempotency by envelope.id
    creates AuditEvent
      source_feature = "customer"
      source_event = "customer_created"
      subject_type = "customer"
      subject_id = payload.customer_id

  job record_issue_status_changed
    trigger event issue.issue_status_changed
    idempotency by envelope.id
    creates AuditEvent
      source_feature = "issue"
      source_event = "issue_status_changed"
      subject_type = "issue"
      subject_id = payload.issue_id

  job record_invoice_paid
    trigger event billing.invoice_paid
    idempotency by envelope.id
    creates AuditEvent
      source_feature = "billing"
      source_event = "invoice_paid"
      subject_type = "invoice"
      subject_id = payload.invoice_id

  surface web admin
    view recent Table
      source query.recent
      columns source_feature, source_event, subject_type, subject_id, created_at

    view by_subject Table
      source query.by_subject(subject_type: route.subject_type, subject_id: route.subject_id)
      columns source_event, actor, created_at
