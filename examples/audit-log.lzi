# Audit log pressure test.
# Exercises cross-cutting event capture and query-heavy surfaces.
# Design fixture only; candidate event subscription constructs are not compiler-executable yet.

feature audit_log
  purpose "Persist important domain events for compliance, support, and debugging."

  non_goals
    "full event sourcing"
    "analytics warehouse"

  uses org, user, customer, issue, billing

  domain
    resource AuditEvent
      tenancy org
      actor: User optional
      source_feature: Text required
      source_event: Text required
      subject_type: Text required
      subject_id: ID required
      payload: JSON required

      timestamps

    query by_subject
      params
        subject_type: Text
        subject_id: ID

      filters
        subject_type = params.subject_type
        subject_id = params.subject_id

      order created_at desc
      paginate 100

    query recent
      order created_at desc
      paginate 100

  policies
    create system
    read role_admin, support_agent
    update none
    delete none

  on customer.customer_created
    policy system
    creates AuditEvent
    derive source_feature = "customer"
    derive source_event = "customer_created"
    derive subject_type = "customer"
    derive subject_id = event.customer_id
    derive payload = event

  on issue.issue_status_changed
    policy system
    creates AuditEvent
    derive source_feature = "issue"
    derive source_event = "issue_status_changed"
    derive subject_type = "issue"
    derive subject_id = event.issue_id
    derive payload = event

  on billing.invoice_paid
    policy system
    creates AuditEvent
    derive source_feature = "billing"
    derive source_event = "invoice_paid"
    derive subject_type = "invoice"
    derive subject_id = event.invoice_id
    derive payload = event

  surface web admin
    view recent Table
      source query.recent
      columns source_feature, source_event, subject_type, subject_id, created_at

    view by_subject Table
      source query.by_subject(subject_type: route.subject_type, subject_id: route.subject_id)
      columns source_event, actor, created_at
