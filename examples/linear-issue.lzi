# Linear issue canonical fixture.
# Exercises workflow, assignment, labels, filters, tree queries, and custom UI blocks.
# Design fixture only; parser and codegen coverage may lag this surface.

feature issue
  purpose "Linear-style issue tracking with workflow, assignee, labels, and sub-issues."

  non_goals
    comment: "comments as first-class resource for now"
    anti_pattern.recursive_tree: "full recursive tree modeling in declarative query"

  uses team, user, project, cycle, label

  domain
    enum IssueStatus
      backlog
      todo
      in_progress
      in_review
      done
      canceled

    enum IssuePriority
      none
      low
      medium
      high
      urgent

    resource Issue
      tenancy team
      project: Project optional
      cycle: Cycle optional
      parent: Issue optional
      creator: User required
      assignee: User optional
      title: Text required
      description: Text optional
      status: IssueStatus = backlog
      priority: IssuePriority = none
      labels: many Label

      soft_delete
      timestamps

    constraints
      unique title per team
      index team, status
      index team, assignee

    query.list list
      params
        status: IssueStatus optional
        priority: IssuePriority optional
        assignee: User optional
        label: Label optional
        project: Project optional
        cycle: Cycle optional

      filters
        status when params.status
        priority when params.priority
        assignee when params.assignee
        project when params.project
        cycle when params.cycle
        labels has params.label when params.label

      order updated_at desc
      paginate 100

    query.lookup by_id by id: ID

    query.list sub_issues
      params
        parent_id: ID

      filters
        parent.id = params.parent_id

      order priority desc

    query.sql tree
      returns IssueTreeNode[]

      params
        root_id: ID

      scope
        team = ctx.team
        deleted_at = nil

      sql "./queries/issue_tree.sql"

    event issue_created
      issue_id: ID
      team_id: ID
      creator_id: ID

    event issue_status_changed
      issue_id: ID
      from: IssueStatus
      to: IssueStatus
      by_id: ID

    event issue_assigned
      issue_id: ID
      assignee_id: ID
      by_id: ID

  policies
    create: @scope.team_member
    update: @scope.team_member
    delete: @role.team_admin
    read: @scope.same_team

  command create
    input title, description, project, cycle, assignee, priority, labels
    policy create
    creates Issue
      title = input.title
      description = input.description
      project = input.project
      cycle = input.cycle
      assignee = input.assignee
      priority = input.priority
      labels = input.labels
      creator = ctx.user
    emits issue_created

  command assign
    route id: ID
    input
      assignee: User
    policy update
    updates Issue
      assignee = input.assignee
    emits issue_assigned

  workflow status on Issue.status
    policy update
    emits issue_status_changed

    triage: backlog -> todo

    start: todo -> in_progress

    submit_review: in_progress -> in_review

    complete: in_review -> done

    reopen: done -> in_progress

    cancel_backlog: backlog -> canceled

    cancel_todo: todo -> canceled

    cancel_in_progress: in_progress -> canceled

    cancel_in_review: in_review -> canceled

  surface web admin
    view list Table
      source query.list
      columns title, status, priority, assignee, project, cycle, updated_at
      search title
      filter status, priority, assignee, label, project, cycle

      cells
        status @client.status_cell
        priority @client.priority_cell

    view detail SidePanel
      source query.by_id(id: route.id)
      block @client.comment_thread
      block @client.sub_issue_list

    view tree Table
      source query.tree(root_id: route.id)
      columns title, status, assignee

  extensions
    client status_cell: CellRenderer[Issue]
    client priority_cell: CellRenderer[Issue]
    client comment_thread: ViewBlock[Issue]
    client sub_issue_list: ViewBlock[Issue]

    hook before_create: Hook[CreateIssue]
    hook after_assign: Hook[AssignIssue]
    fn rank_score: Function[Issue, IssueRankScore]
