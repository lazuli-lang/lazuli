# Linear-style issue feature pressure test.
# Indentation-based design fixture, not compiler-executable yet.

feature issue
  purpose "Linear-style issue tracking with workflow, assignee, labels, and sub-issues."

  non_goals
    "comments as first-class resource for now"
    "full recursive tree modeling in declarative query"

  domain
    enum IssueStatus
      backlog
      todo
      in_progress
      in_review
      done
      canceled

    enum IssuePriority
      none
      low
      medium
      high
      urgent

    resource Issue
      team_id: Team required
      project_id: Project optional
      cycle_id: Cycle optional
      parent_id: Issue optional
      creator_id: User required
      assignee_id: User optional
      title: Text required
      description: Text optional
      status: IssueStatus = backlog
      priority: IssuePriority = none
      labels: many Label

      soft_delete
      timestamps

    constraints
      unique title per team_id
      index team_id, status
      index team_id, assignee_id

    query list
      params
        status: IssueStatus optional
        assignee_id: ID optional
        label_id: ID optional
        project_id: ID optional
        cycle_id: ID optional

      where
        team_id = ctx.team.id
        deleted_at = nil

      order updated_at desc
      paginate 100

    query by_id
      params
        id: ID

      where
        id = id
        team_id = ctx.team.id

    query sub_issues
      params
        parent_id: ID

      where
        parent_id = parent_id
        team_id = ctx.team.id
        deleted_at = nil

      order priority desc

    # Pressure point: recursive sub-issue trees may need a richer query concept.
    query tree raw
      returns IssueTreeNode[]

      params
        root_id: ID

      sql "./queries/issue_tree.sql"

    rule "done issues can only reopen to in progress"
      forbid Issue.transition where issue.status = done and next_status = todo
      message "Done issues reopen directly to in progress"

    event issue_created
      id: ID
      team_id: ID
      creator_id: User

    event issue_status_changed
      id: ID
      from: IssueStatus
      to: IssueStatus
      by: User

    event issue_assigned
      id: ID
      assignee_id: User
      by: User

  policies
    create team_member
    update team_member
    delete team_admin
    read same_team

  command create
    input title, description, project_id, cycle_id, assignee_id, priority, labels
    policy create
    emits issue_created

  command assign
    input assignee_id: ID
    policy update
    emits issue_assigned

  workflow status
    start: todo -> in_progress
      policy update
      emits issue_status_changed

    submit_review: in_progress -> in_review
      policy update
      emits issue_status_changed

    complete: in_review -> done
      policy update
      emits issue_status_changed

    reopen: done -> in_progress
      policy update
      emits issue_status_changed

  surface web admin
    view list Table
      source query.list
      columns title, status, priority, assignee_id, project_id, cycle_id, updated_at
      search title
      filter status, priority, assignee_id, label_id, project_id, cycle_id

      cells
        status ext.status_cell
        priority ext.priority_cell

    view detail SidePanel
      source query.by_id(id: route.id)
      block ext.comment_thread
      block ext.sub_issue_list

    view tree Table
      source query.tree(root_id: route.id)
      columns title, status, assignee_id

  extensions
    client status_cell: CellRenderer[Issue]
    client priority_cell: CellRenderer[Issue]
    client comment_thread: ViewBlock[Issue] at "./ui/comment_thread.tsx"
    client sub_issue_list: ViewBlock[Issue] at "./ui/sub_issue_list.tsx"

    server before_create: Hook[CreateIssue]
    server after_assign: Hook[AssignIssue]
    server rank_score: Function[Issue, IssueRankScore] at "./domain/rank_score.go"
