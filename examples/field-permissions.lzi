# Field permissions pressure test.
# Exercises field-level read/write restrictions.
# Design fixture only; parser and codegen coverage may lag this surface.

feature customer_sensitive
  purpose "Customer fields with role-specific visibility and write access."

  non_goals
    delegated_to
      customer: "customer lifecycle ownership"

  uses org, user, customer

  domain
    resource CustomerSensitiveProfile
      tenancy org
      customer: Customer required
      legal_name: Text @pii.contact required
      tax_id: Encrypted(key:@key.tenant) @pii.identifier required
      annual_revenue: Encrypted(key:@key.tenant) @pii.financial optional
      internal_notes: Encrypted(key:@key.tenant) @pii.derived optional

      soft_delete
      retention 7y then anonymize
      timestamps

    query.lookup by_customer
      params
        customer_id: ID

      filters
        customer.id == params.customer_id

  policies
    view: @scope.same_org
    edit: @role.admin, @role.finance_admin
    remove: @role.admin

    fields CustomerSensitiveProfile
      legal_name
        read: @scope.same_org
        write: @role.admin, @role.finance_admin

      tax_id
        read: @role.finance_admin
        write: @role.finance_admin

      annual_revenue
        read: @role.finance_admin, @role.sales_manager
        write: @role.finance_admin

      internal_notes
        read: @role.admin, @scope.account_owner
        write: @role.admin, @scope.account_owner

  command update_financials
    route customer_id: ID
    input
      legal_name: Text
      tax_id: Text
      annual_revenue: Money optional
    target query.by_customer(customer_id: route.customer_id)
    policy @policy.edit
    rate_limit "30 per minute per user"
    audit default
    updates CustomerSensitiveProfile
      legal_name = input.legal_name
      tax_id = input.tax_id
      annual_revenue = input.annual_revenue

  surface web admin
    view detail SidePanel
      source query.by_customer(customer_id: route.customer_id)
      columns legal_name, tax_id, annual_revenue, internal_notes
