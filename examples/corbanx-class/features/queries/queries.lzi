# The heart of the corbanx-shaped fixture.
# A Query is a single tax-id consult dispatched to N providers in parallel.
# Each provider response is a QueryResult.
# Provider A is sync; Provider B returns PENDING and must be polled — this
# exercises the `kind poller` gap (#5).
# Downloading filtered results as CSV/XLSX exercises the report gap (#3, #4).

feature queries
  purpose "Dispatch parallel provider consults for a tax-id, aggregate results, allow CSV/XLSX export."

  defaults
    tenancy company
    timestamps
    policy_for jobs, webhooks: @actor.system

  uses companies, credentials, billing

  domain
    enum QueryStatus
      processing
      completed
      failed

    enum ProviderResultStatus
      pending
      with_balance
      no_balance
      failed

    resource Query
      company: Company required on_delete cascade
      user: User required on_delete restrict
      # NOTE: gap #12 — @semantic.TaxID lives in the deferred scalars-pt-BR plugin.
      tax_id: Text @pii.contact required
      name: Text required
      total_providers: Integer = 0
      providers_with_balance: Integer = 0
      providers_failed: Integer = 0

      retention 2y then anonymize

      lifecycle status
        state processing initial
        state completed terminal
        state failed terminal

        transition complete
          from processing
          to completed
          policy @policy.update
          audit default
          emits query_completed, query_status_changed

        transition fail
          from processing
          to failed
          policy @policy.update
          audit default
          emits query_failed, query_status_changed

    resource QueryResult
      query: Query required on_delete cascade
      provider: Provider required
      credential: ProviderCredential optional
      status: ProviderResultStatus = pending
      result: JSON optional
      margin_cents: Integer optional
      external_consult_id: Text optional

    # PendingResolution is the cursor table the `poller
    # resolve_pending_provider_b` block (below, at feature level) walks.
    # The poller proposal (docs/proposals/poller-vocab.md §3) names this
    # pattern; in v0 the cursor fields live on the resource itself and
    # the poller block binds them via `cursor`.
    resource PendingResolution
      company: Company required
      query: Query required on_delete cascade
      result: QueryResult required on_delete cascade
      provider: Provider required
      external_consult_id: Text required
      attempts: Integer = 0
      next_check_at: DateTime required
      resolved_at: DateTime optional
      status_v8: ProviderResultStatus = pending
      final_status: ProviderResultStatus optional
      gender: Text optional
      gender_retry_count: Integer = 0

    constraints
      unique query, provider
      unique external_consult_id per provider

    query.list list_queries
      params
        status: QueryStatus optional
        tax_id: Text optional

      filters
        status when params.status
        tax_id when params.tax_id

      cache
        key queries.list_queries(params)
        ttl 30s
        tags query-list
        namespace queries

      paginate 50

    query.lookup query_by_id by id: ID

    query.list results_for_query
      params
        query_id: ID

      filters
        query.id = params.query_id

      order provider asc

    query.list pending_resolutions
      params
        provider: Provider optional

      filters
        resolved_at = nil
        next_check_at < ctx.now
        provider when params.provider

      order next_check_at asc
      paginate 100

    event_group query_* on Query
      payload
        query_id = id
        company_id = company.id
        user_id = user.id
        by_id = ctx.user.id when @actor.user

      event dispatched
        providers: JSON
      event status_changed
        from: QueryStatus
        to: QueryStatus
      event completed
      event failed

    event provider_result_recorded
      query_id: ID
      provider: Provider
      status: ProviderResultStatus

  policies
    # NOTE: when plan-and-gate vocab lands, these become gated by
    # billing.subscription.plan — see GAPS.md.
    start_query: @scope.same_company
    update: @scope.same_company
    read_query: @scope.same_company
    download_results: @scope.same_company

    fields Query
      tax_id
        read: @scope.same_company
        write: @scope.same_company

  command start_query
    input
      tax_id: Text required
      name: Text required
      providers: JSON required
    gate quota plan.limit: start_query_per_month
    policy @policy.start_query
    rate_limit "60 per hour per user"
    audit default
    creates Query
      company = ctx.actor.company
      user = ctx.user
      tax_id = input.tax_id
      name = input.name
    emits query_dispatched
      providers = input.providers
    invalidates
      query.list_queries

  # Tabular export of provider results for one query. The static-columns
  # half of corbanx's multi-bank report (docs/proposals/report-vocab.md
  # v0.2 anchor). Dynamic per-bank columns remain `api + handler` until
  # the v0.2 `expand` extension ships.
  report download_results
    source query.results_for_query
    columns
      provider from row.provider
      status from row.status
      margin_cents from row.margin_cents label "Margem (cents)"
      external_consult_id from row.external_consult_id label "External consult ID"
    formats csv, xlsx
    storage object_storage.files
    visibility signed
    signed_ttl 1h
    filename "query_results_{ctx.now:yyyymmdd}.{format}"
    policy @policy.download_results
    rate_limit "10 per hour per user"
    audit actor, ctx.now

  # L0 #8 — `kind poller` makes the V8-style async resolution loop
  # declarative. The dispatcher SELECTs pending rows on `next_check_at`,
  # calls @fn.poll_provider_b per row, and either marks the row resolved
  # (writing `final_status` + emitting `provider_result_recorded`) or
  # recomputes `next_check_at` via exponential backoff for another tick.
  # See docs/proposals/poller-vocab.md §1.1 (worked example).
  poller resolve_pending_provider_b
    source PendingResolution
    cursor
      eligible_when next_check_at, resolved_at
      attempts attempts
    retry
      max_attempts 30
      backoff exponential base 30s cap 10m
    states
      pending initial
      gender_ambiguous intermediate
      resolved terminal
      failed terminal
    resolve via @fn.poll_provider_b
    terminal_status_field final_status
    tick every 15s batch 100
    tenant_from row.company_id
    idempotency by row.id, row.attempts
    audit default
    emits provider_result_recorded
    retry_quirk gender_flip_once
      when row.status_v8 == "gender_ambiguous"
      counter gender_retry_count
      mutate row.gender = flip(row.gender)

  job dispatch_provider_queries
    trigger event queries.query_dispatched
    queue provider_queries
    tenant_from payload.company_id
    idempotency by payload.query_id
    retry 3 backoff exponential
    timeout "60s"
    handler "./jobs/dispatch_provider_queries.go"
    emits provider_result_recorded

  extensions
    # Export handlers (`fn export_results_csv` / `fn export_results_xlsx`)
    # removed: `report download_results` (above) replaces them declaratively.
    fn poll_provider_b: Function[PendingResolution, JSON] at "./handlers/poll_provider_b.go"
