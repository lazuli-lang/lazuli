# User/auth pressure test.
# Exercises auth, sessions, MFA, OAuth, rate limiting, and public commands.
# Design fixture only; parser and codegen coverage may lag this surface.

feature user
  purpose "User identity, login sessions, MFA, and account recovery."

  non_goals
    delegated_to
      org: "organization membership"
      billing: "billing identity"

  domain
    enum UserStatus
      invited
      active
      locked
      disabled

    enum AuthProvider
      password
      google
      github

    resource User
      email: @semantic.Email @pii.contact required
      display_name: Text optional
      status: UserStatus = invited
      password_hash: @cap.Hashed(algorithm:argon2id) optional
      mfa_enabled: Boolean = false

      soft_delete
      timestamps

    resource Session
      user: User required
      refresh_token_hash: @cap.Hashed(algorithm:argon2id) required
      provider_access_token: @cap.Encrypted(key:@key.tenant) @pii.credential optional
      provider: AuthProvider required
      expires_at: DateTime required

      timestamps

    query.lookup by_id by id: ID

    query.lookup by_email by email: @semantic.Email

    query.list active_sessions
      params
        user_id: ID

      filters
        user.id = params.user_id
        expires_at != nil

    event user_registered
      user_id: ID
      email: @semantic.Email @pii.contact

    event user_logged_in
      user_id: ID
      session_id: ID
      provider: AuthProvider

    event user_mfa_enabled
      user_id: ID
      by_id: ID

  policies
    register: @scope.public
    login: @scope.public
    read: @scope.self, @role.admin
    update: @scope.self, @role.admin
    delete: @role.admin

    fields User
      email
        read: @scope.self, @role.admin
        write: @scope.self, @role.admin

      password_hash
        read: @actor.system
        write: @actor.system

    fields Session
      refresh_token_hash
        read: @actor.system
        write: @actor.system

      provider_access_token
        read: @actor.system
        write: @actor.system

  auth
    identity User.email

    password
      algorithm argon2id
      hash @fn.hash_password
      verify @fn.verify_password
      rate_limit "5 per 10 minutes"

    oauth google
      adapter @adapter.google_oauth

    mfa totp
      enroll @fn.enroll_totp
      verify @validator.verify_totp

    sessions
      resource Session
      ttl "30 days"
      refresh true

  command register
    input
      email: @semantic.Email
      password: Text
      display_name: Text optional
    policy @policy.register
    rate_limit "5 per 10 minutes per ip"
    creates User
      email = input.email
      password_hash = @fn.hash_password(input.password)
      display_name = input.display_name
      status = UserStatus.active
    emits user_registered

  command login
    input
      email: @semantic.Email
      password: Text
    policy @policy.login
    rate_limit "5 per 10 minutes per ip"
    returns AuthSession
    emits user_logged_in

  command enable_mfa
    route id: ID
    input
      totp_code: Text
    policy @policy.update
    rate_limit "10 per minute per user"
    updates User
      mfa_enabled = true
    emits user_mfa_enabled

  surface web public
    view login Form
      submit command.login
      fields email, password

    view register Form
      submit command.register
      fields email, password, display_name

  surface web admin
    view detail SidePanel
      source query.by_id(id: route.id)

  extensions
    fn hash_password: Function[Text, @cap.Hashed(algorithm:argon2id)] at "./auth/hash_password.go"
    fn verify_password: Function[PasswordVerifyInput, PasswordVerifyResult] at "./auth/verify_password.go"
    adapter google_oauth: IntegrationAdapter[GoogleOAuth] at "./integrations/google_oauth.go"
    fn enroll_totp: Function[User, TotpEnrollment] at "./auth/enroll_totp.go"
    validator verify_totp: Validator[TotpVerifyInput] at "./auth/verify_totp.go"
