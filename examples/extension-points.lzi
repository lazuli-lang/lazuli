# Extension points canonical fixture.
# Exercises raw queries, SQL files, and typed extension boundaries.
# Design fixture only; parser and codegen coverage may lag this surface.

feature customer_metrics
  uses org, customer

  domain
    record CustomerLtv
      customer_id: ID
      amount: Money
      currency: Text

    query.sql customer_lifetime_value
      returns CustomerLtv[]

      scope
        org = ctx.user.org

      sql "./queries/customer_ltv.sql"

  surface web admin
    view ltv_report Table
      source query.customer_lifetime_value
      columns customer_id, amount, currency

  extensions
    client ltv_cell: CellRenderer[CustomerLtv]
    hook refresh_ltv: Hook[RefreshCustomerLtv]

  escape_route "/admin/raw-sql-console"
    at "./pages/sql_console.tsx"
    policy @role.admin
    tenant org
