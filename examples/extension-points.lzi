# Sketch syntax for Lazuli extension contracts.
# This file documents escape hatches, not the normal path.

feature customer_metrics
  domain
    query customer_lifetime_value raw
      returns CustomerLtv[]

      params
        org_id: ID

      sql "./queries/customer_ltv.sql"

  surface web admin
    view ltv_report Table
      source query.customer_lifetime_value(org_id: ctx.user.org_id)
      columns customer_id, amount, currency

  extensions
    client ltv_cell: CellRenderer[CustomerLtv] at "./ui/ltv_cell.tsx"
    server refresh_ltv: Hook[RefreshCustomerLtv]

  escape_route "/admin/raw-sql-console" at "./pages/sql_console.tsx"
