# Notification pressure test.
# Exercises the declarative `notification <name>` primitive: channel
# dispatch, template render, retry, idempotency, and tenant fan-out
# are all owned by the Lazuli runtime contract — no user-space queue.

feature notification
  purpose "Deliver email and in-app notifications from domain events."

  uses org, user, customer, issue

  policies
    notify: @actor.system

  notification customer_archived
    channel email
    recipient target.email
    trigger event customer.customer_archived
    tenant_from payload.org_id
    idempotency by envelope.id
    retry 3 backoff exponential
    template "./templates/customer_archived.mjml"
    policy @policy.notify
    emits customer_archived_sent

  notification issue_assigned
    channel in_app
    recipient target.user_id
    trigger event issue.issue_assigned
    tenant_from payload.org_id
    idempotency by envelope.id
    retry 3 backoff exponential
    template "./templates/issue_assigned.mjml"
    policy @policy.notify
    emits issue_assigned_sent
