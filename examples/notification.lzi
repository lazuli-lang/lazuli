# Notification pressure test.
# Exercises event consumption and external effects.
# Design fixture only; parser and codegen coverage may lag this surface.

feature notification
  purpose "Deliver email and in-app notifications from domain events."

  non_goals
    anti_pattern.event_source_of_truth: "producers own their events"
    anti_pattern.preferences_ui: "user preferences UI beyond notification settings"

  defaults
    policy @actor.system

  uses org, user, customer, issue

  domain
    enum NotificationChannel
      email
      in_app

    enum NotificationStatus
      queued
      sent
      failed

    resource Notification
      tenancy org
      recipient: User required
      channel: NotificationChannel required
      status: NotificationStatus = queued
      subject: Text required
      body: Text required
      source_event: Text required

      timestamps

    query.list inbox
      params
        recipient: User

      filters
        recipient = params.recipient

      order created_at desc
      paginate 50

    event notification_queued
      notification_id: ID
      org_id: ID
      recipient_id: ID

    event notification_sent
      notification_id: ID
      provider_message_id: Text

  policies
    create: @actor.system
    read: @scope.self, @role.admin
    update: @actor.system
    delete: @role.admin

  job queue_customer_archived
    trigger event customer.customer_archived
    idempotency by envelope.id
    retry 3 backoff exponential
    creates Notification
      recipient = payload.by_id
      channel = NotificationChannel.email
      subject = "Customer archived"
      body = @fn.render_customer_archived(payload)
    emits notification_queued

  job queue_issue_assigned
    trigger event issue.issue_assigned
    idempotency by envelope.id
    retry 3 backoff exponential
    creates Notification
      recipient = payload.assignee_id
      channel = NotificationChannel.in_app
      subject = "Issue assigned"
      body = @fn.render_issue_assigned(payload)
    emits notification_queued

  job send_queued
    trigger schedule "*/2 * * * *"
    handler "./jobs/send_queued.go"
    emits notification_sent

  surface web admin
    view inbox Table
      source query.inbox(recipient: ctx.user)
      columns subject, channel, status, created_at
      filter channel, status

  extensions
    fn render_customer_archived: Function[CustomerArchivedPayload, Text] at "./templates/customer_archived.go"
    fn render_issue_assigned: Function[IssueAssignedPayload, Text] at "./templates/issue_assigned.go"
