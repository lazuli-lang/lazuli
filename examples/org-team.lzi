# Org/team pressure test.
# Exercises tenancy host resources, membership, role inheritance, and multi-surface.
# Design fixture only; parser and codegen coverage may lag this surface.

feature org
  purpose "Organizations, teams, memberships, and role inheritance for tenant-aware features."

  non_goals
    delegated_to
      user: "user identity"
      billing: "billing subscription ownership"

  uses user

  domain
    enum MembershipRole
      owner
      admin
      member
      guest

    resource Org
      name: Text required
      slug: Text required

      soft_delete
      timestamps

    resource Team
      tenancy org
      name: Text required
      slug: Text required

      soft_delete
      timestamps

    resource Membership
      tenancy org
      user: User required
      role: MembershipRole = member
      team: Team optional

      timestamps

    constraints
      unique slug per Org
      unique user, team per org

    query.list my_orgs
      params
        user: User

      filters
        user = params.user

    query.list teams
      order name asc

    event org_created
      org_id: ID
      owner_id: ID

    event member_invited
      org_id: ID
      user_id: ID
      role: MembershipRole

  policies
    create: @scope.authenticated
    read: @scope.org_member
    update: @role.org_admin
    delete: @role.org_owner
    invite: @role.org_admin

  command create
    input name, slug
    policy @policy.create
    creates Org
      name = input.name
      slug = input.slug
    emits org_created

  command invite_member
    input
      email: @semantic.Email
      role: MembershipRole
      team: Team optional
    policy @policy.invite
    creates Membership
      user = @fn.resolve_or_invite_user(input.email)
      role = input.role
      team = input.team
    emits member_invited

  surface web admin
    view teams Table
      source query.teams
      columns name, slug, created_at

  surface mobile member
    view my_orgs Table
      source query.my_orgs(user: ctx.user)
      columns org, role

  extensions
    fn resolve_or_invite_user: Function[@semantic.Email, User]
