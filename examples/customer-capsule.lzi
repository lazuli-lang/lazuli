# Customer capsule canonical fixture.
# Exercises CRM customer lifecycle, ownership, tiering, scoring, and admin experience.
# Design fixture only; parser and codegen coverage may lag this surface.

feature customer
  purpose "CRM customers within an org. Tracks lifecycle status, ownership, and tier."

  non_goals
    delegated_to
      invoice: "invoicing"
      scoring: "credit scoring engine"
      user: "user authentication"

  uses org, user

  domain
    enum CustomerStatus
      lead
      active
      archived

    resource Customer
      tenancy org
      owner: User required
      name: Text required
      email: Email required

      soft_delete
      timestamps

      lifecycle status
        state lead initial
        state active
        state archived terminal

        transition activate
          from lead
          to active
          policy @policy.edit
          emits customer_activated

        transition archive
          from active
          to archived
          policy @policy.edit
          emits customer_archived

    constraints
      unique email per org

    query.list list
      params
        status: CustomerStatus optional

      filters
        status when params.status

      paginate 50

    query.lookup by_id by id: ID

    rule "deleted customers cannot be archived"
      deny Customer.archive when self.deleted_at != nil
      message "Cannot archive a deleted customer"

    event_group customer_* on Customer
      payload
        customer_id = id
        org_id = org.id
        by_id == ctx.user.id when @actor.user

      event created
        email: Email

      event activated

      event archived

  policies
    author: @role.admin, @role.sales
    edit: @role.admin, @role.sales
    remove: @role.admin
    view: @scope.same_org

  command create
    input name, email
    policy @policy.author
    rate_limit "30 per hour per user"
    creates Customer
      name = input.name
      email = input.email
      owner = ctx.user
    emits customer_created

  extensions
    client status_cell: CellRenderer[Customer]
    hook before_create: Hook[CreateCustomer]
    fn risk_score: Function[Customer, Integer]
