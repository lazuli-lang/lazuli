# production-grade fixture — B2B finance app shape.
# Multi-tenant Companies, RBAC, async provider queries, encrypted credentials, exports.
# Generic placeholder vocabulary (no proprietary terms).

app ProductionGrade
  title "Production-Grade Demo"
  version "0.1.0"
  default_timezone "America/Sao_Paulo"

  lazuli_version "0.13"

  # PG.F — Plan & Gate vocabulary anchor. Names the resource that
  # holds the active subscription for the calling tenant. See
  # docs/proposals/plan-and-gate-vocab.md §"Subscription anchor".
  subscription resource billing.subscription

  locale
    default "pt-BR"
    supported "pt-BR", "en-US"
    fallback "en-US" -> "pt-BR"

  uses
    companies
    auth
    credentials
    queries
    webhooks
    billing

  targets
    backend go

  environments
    local
    staging
    production

  urls
    api local "http://localhost:8080"
    api production "https://api.production-grade.example"
    web local "http://localhost:3000"
    web production "https://app.production-grade.example"

  cors
    allow_origins production "https://app.production-grade.example"
    allow_origins local "http://localhost:3000"
    allow_credentials true
    max_age "1h"

  runtime
    unit api
      serves queries, commands, webhooks, apis
      healthcheck "/healthz"
      readiness "/readyz"

    unit worker
      runs jobs *

    unit scheduler
      runs schedules *

  deploy
    migrations before_deploy
    migration_lock required
    destructive_migrations require_approval
    rollback on_failed_healthcheck
    strategy rolling

  logging
    level info
    format json
    redact pii

  tracing
    propagate true
    sample_rate 0.1

  # Encryption bucket cycle — bind every `Encrypted(key:@key.tenant)`
  # field on `Credential` (and any other tenant-keyed field) to a per-
  # tenant env var template. See `docs/proposals/encryption-vocab.md`.
  encryption
    key @key.tenant
      source env.CRYPT_KEY_TENANT_{tenant_id}
      algorithm aes_256_gcm
      rotation manual
