# Provider credentials, encrypted at rest.
# Each Company can hold N credentials (one per provider × environment).
# This feature directly exercises the encryption gap (#2 in
# `docs/proposals/production-readiness.md`).

feature credentials
  purpose "Per-company provider credentials, encrypted at rest, scoped to current tenant."

  defaults
    tenancy company
    timestamps

  uses companies

  domain
    enum Provider
      provider_a
      provider_b
      provider_c

    enum ProviderEnv
      sandbox
      production

    resource ProviderCredential
      company: Company required on_delete cascade
      provider: Provider required
      environment: ProviderEnv required
      label: Text required

      # NOTE: Encrypted exists in the cap catalog
      # (`docs/quickref.md:797-799`) and is currently honored by
      # @pii.* tags but there is no `encrypted-vocab.md` proposal
      # nailing down WHERE the key comes from, key rotation, or
      # the runtime encryption contract. See GAPS.md.
      username: Encrypted(key:@key.tenant) @pii.credential required
      secret: Encrypted(key:@key.tenant) @pii.credential required
      token: Encrypted(key:@key.tenant) @pii.credential optional

      last_used_at: DateTime optional
      disabled_at: DateTime optional

      soft_delete
      retention 2y then delete

    constraints
      unique company, provider, environment, label

    query.list list_credentials
      params
        provider: Provider optional

      filters
        provider when params.provider

      paginate 50

    query.lookup credential_by_id by id: ID

    event_group credential_* on ProviderCredential
      payload
        credential_id = id
        company_id = company.id
        provider = provider
        by_id == ctx.user.id when @actor.user

      event created
      event updated
      event disabled
      event used

  policies
    author: @role.company_admin
    edit: @role.company_admin
    remove: @role.company_admin
    view: @scope.same_company

    fields ProviderCredential
      username
        read: @actor.system
        write: @role.company_admin
      secret
        read: @actor.system
        write: @role.company_admin
      token
        read: @actor.system
        write: @actor.system

  command register_credential
    input
      provider: Provider required
      environment: ProviderEnv required
      label: Text required
      username: Text required
      secret: Text required
    policy @policy.author
    rate_limit "20 per hour per user"
    audit default
    creates ProviderCredential
      provider = input.provider
      environment = input.environment
      label = input.label
      username = input.username
      secret = input.secret
      company = ctx.actor.company
    emits credential_created

  command disable_credential
    route id: ID
    target query.credential_by_id(id: route.id)
    policy @policy.edit
    rate_limit "60 per minute per user"
    audit default
    updates ProviderCredential
      disabled_at = ctx.now
    emits credential_disabled

  # RB.S6 — structured `policy <expr>` form. Demonstrates `has_role` +
  # `has_permission` predicates landing on the closed expression
  # parser. Codegen lowers these to `rbac.role` / `rbac.permission`
  # PolicyAtom entries the runtime evaluates via `ctx.User.Roles`.
  command rotate_credential
    route id: ID
    target query.credential_by_id(id: route.id)
    policy authenticated and has_permission credentials:update
    rate_limit "30 per hour per user"
    audit default
    updates ProviderCredential
      last_used_at = ctx.now
    emits credential_used
