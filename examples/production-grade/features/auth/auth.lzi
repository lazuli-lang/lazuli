# Auth feature — session + login + RBAC catalog.
#
# RB.F (rbac-catalog-vocab.md): top-level `permission` / `role`
# decls sit ABOVE the `feature auth` block. They are package-scoped,
# not feature-scoped — placement here is convention only.
#
# Closure example: `manager` transitively grants every permission
# `consultor` grants plus its own additions, and `manager` is a
# parent of `company_admin` which inherits everything from manager.
# `platform_admin` grants everything via `grants_all`.

# Permission catalog (10 entries).
permission companies:read
permission companies:create
permission companies:update
permission companies:invite_member
permission credentials:read
permission credentials:create
permission credentials:update
permission credentials:delete
permission queries:start
permission queries:download_results

# Role hierarchy (5 roles, 4-deep chain: viewer < consultor < manager
# < company_admin, plus platform_admin grants_all).
role viewer
  grants
    companies:read
    credentials:read

role consultor
  inherits viewer
  grants
    queries:start

role manager
  inherits consultor
  grants
    queries:download_results

role company_admin
  inherits manager
  grants
    companies:update
    companies:invite_member
    credentials:create
    credentials:update
    credentials:delete

role platform_admin
  grants_all

feature auth
  purpose "User login, sessions, password verification."

  defaults
    timestamps

  uses companies

  domain
    resource UserSession
      user: User required on_delete cascade
      refresh_token_hash: Hashed(algorithm:argon2id) required
      expires_at: DateTime required
      retention 30d then delete

    query.list active_sessions
      params
        user_id: ID

      filters
        user.id = params.user_id
        expires_at > ctx.now

    event user_logged_in
      user_id: ID
      session_id: ID

    event user_logged_out
      user_id: ID
      session_id: ID

  policies
    login: @scope.public
    read_session: @actor.system

    fields UserSession
      refresh_token_hash
        read: @actor.system
        write: @actor.system

  auth
    identity User.email

    password
      algorithm argon2id
      hash @fn.hash_password
      verify @fn.verify_password
      rate_limit "5 per 10 minutes"

    sessions
      resource UserSession
      ttl "7 days"
      refresh false

  command login
    input
      email: Email required
      password: Text required
    policy @policy.login
    rate_limit "5 per 10 minutes per ip"
    returns Text
    emits user_logged_in

  # NOTE: the RBAC catalog lives at top level (above this `feature`
  # block). See `permission` / `role` declarations at the file head
  # and `docs/proposals/rbac-catalog-vocab.md` §Where the catalog lives.

  extensions
    fn hash_password: Function[Text, Hashed(algorithm:argon2id)] at "./handlers/hash_password.go"
    fn verify_password: Function[PasswordVerifyInput, PasswordVerifyResult] at "./handlers/verify_password.go"
