contract acme.ai.v1
  purpose "AI inference service for customer summaries and lifecycle signals."
  compatibility backward
  import openapi "./contracts/ai.openapi.json"

  record CustomerSummaryRequest
    org_id: ID required
    customer_id: ID required
    name: Text required
    email: @semantic.Email @pii.contact optional
    status: Text required

  record CustomerSummaryResult
    customer_id: ID required
    summary: Text required
    model: Text required
    generated_at: DateTime required

  operation summarize_customer
    transport http
    method POST
    path "/v1/customer-summary"
    input CustomerSummaryRequest
    output stream CustomerSummaryResult
    auth service
    timeout "10s"
    retry 2 backoff exponential
    idempotency by input.customer_id, input.prompt
    error UpstreamUnavailable status 503 expose retry_after
    error PromptRejected status 422 expose reason
    error ContextOverflow status 413 expose limit_tokens, prompt_tokens

  event summary_ready
    topic "ai.summary_ready"
    payload
      org_id: ID required
      customer_id: ID required
      summary: Text required
