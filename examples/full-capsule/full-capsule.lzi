# Full Lazuli canonical fixture.
# Exercises domain, policies, auth, commands, workflows, jobs, webhooks, extensions, and escape routes.
# Experience and surface projections live in sibling .lzx files.
# Granularity: a feature is a product capability, not an entity wrapper.
# Design fixture only; parser and codegen coverage may lag this surface.

feature customer
  purpose "CRM customer lifecycle, ownership, tiering, scoring, and customer-facing surfaces."

  non_goals
    delegated_to
      user: "staff authentication"
      customer_auth: "customer login and MFA"
      customer_tags: "tag management"
      customer_import: "CSV import and external CRM ingestion"
      billing: "invoicing"

  knowledge lazuli-way

  defaults
    tenancy org
    timestamps
    policy_for jobs, webhooks: @actor.system

  uses org, user, billing, customer_audit

  domain
    public contract CustomerStatus as v1
    enum CustomerStatus
      lead = 10
      active = 20
      paused = 30
      archived = 90

    public contract CustomerTier as v1
    enum CustomerTier
      free: label @translation.customer_tier_free, icon "gift"
      pro: label @translation.customer_tier_pro, hint @translation.customer_tier_pro_hint, icon "briefcase"
      enterprise: label @translation.customer_tier_enterprise, hint @translation.customer_tier_enterprise_hint, icon "building-2"

    enum CustomerSource
      manual
      import
      api
      webhook

    public contract Customer as v1
    resource Customer
      previously migrated Account
      owner: User optional
      name: Text required
      email: @semantic.Email @pii.contact required
      brand_color: @semantic.HexColor optional
      health: @semantic.Percentage = 0
      tier: CustomerTier = free
      source: CustomerSource = manual
      score: Integer @pii.derived = 0
      external_id: @cap.Encrypted(key:@key.tenant) @pii.external optional
      is_high_value: Boolean derived from score > 80
      renewal_date: Date optional
      reminder_lead_days: Integer = 7
      renewal_reminder_at: Date computed_date from renewal_date offset reminder_lead_days
      # W4 GAP-08 — rule-driven computed Date: the base Date is selected by
      # the `next_review_rule` binding fn (declared in `extensions`), then
      # shifted by `reminder_lead_days`.
      next_review_at: Date schedule_rule from @fn.next_review_rule(renewal_date) offset reminder_lead_days
      # GAP-12 — cross-feature FK into the append-only audit ledger owned by
      # `customer_audit` (declared in this feature's `uses`).
      last_audit_id: ID target @feature.customer_audit.OperationLog optional
      has_many notes: CustomerNote inverse customer
      many_through CustomerAccountManager to User
        role_in_account: Text required
        assigned_at: DateTime required

      soft_delete
      retention 7y then anonymize

      validates @validator.tier_check

      lifecycle status
        state lead initial
        state active
        state paused
        state archived terminal

        transition activate
          from lead
          to active
          policy @policy.update
          emits customer_activated, customer_status_changed
          tests
            allows from lead
            denies from active
            denies from archived
            denies from paused
            denies as @role.viewer

        transition pause
          from active
          to paused
          policy @policy.update
          emits customer_paused, customer_status_changed
          tests
            allows from active
            denies from lead
            denies from archived

        transition resume
          from paused
          to active
          policy @policy.update
          emits customer_status_changed
          tests
            allows from paused
            denies from active
            denies from lead

        transition archive
          from active
          to archived
          policy @policy.update
          requires @policy.delete
          emits customer_archived, customer_status_changed
          previously migrated deactivate
          tests
            allows from active as @role.admin
            denies from active as @role.sales
            denies from paused
            denies from lead

    resource CustomerNote
      customer: Customer required
      author: User required
      body: Text required
      position: Integer = 0
      pinned: Boolean = false

      unique pinned when pinned = true

    record Address
      line1: Text required
      line2: Text optional
      city: Text required
      postal_code: Text required
      country: Text required

    resource CustomerAddress
      customer: Customer required on_delete cascade
      label: Text required
      address: Address required
      is_default: Boolean = false

      unique is_default when is_default = true

    resource CustomerActivity
      append_only
      actor: User required
      kind: Text required
      polymorphic_ref subject_type subject_id targets [Customer, CustomerNote]

    constraints
      unique email per org
      unique external_id per org

    record CustomerLtv
      customer_id: ID
      amount: @semantic.Money
      currency: Text

    record CustomerRiskRow
      customer_id: ID
      risk_score: Integer
      reason: Text

    record CustomerActivityEvent
      customer_id: ID
      kind: Text
      at: DateTime

    query.list list
      modifier @query_modifier.query_scope_modifier

      params
        status: CustomerStatus optional
        tier: CustomerTier optional
        owner: User optional
        search: Text optional

      filters
        status when params.status
        tier when params.tier
        owner when params.owner

      search params.search over name, email
        mode contains

      cache
        key customer.list(params)
        ttl 5m
        tags customer-list, customer-summary
        namespace customer

      paginate 50

    query.lookup by_id by id: ID

    query.lookup by_email by email: @semantic.Email

    query.list global_search
      policy @policy.global_read

      params
        search: Text

      scope override
        reason "Global admin search intentionally crosses tenant scope."
        deleted_at = nil

      search params.search over name, email
        mode contains

      order updated_at desc
      paginate 100

    query.sql lifetime_value
      returns CustomerLtv[]

      scope
        org = ctx.user.org

      sql "./queries/customer_lifetime_value.sql"

    query.sql churn_risk
      returns CustomerRiskRow[]

      params
        min_score: Integer optional

      scope
        org = ctx.user.org

      sql "./queries/customer_churn_risk.sql"

    rule "archived customers cannot be reassigned"
      deny Customer.reassign when self.status = CustomerStatus.archived
      message @translation.archive_archived_blocked

      tests
        denies when self.status = archived
        allows when self.status = active
        allows when self.status = paused
        allows when self.status = lead

    rule "deleted customers cannot be archived"
      deny Customer.archive when self.deleted_at != nil
      message @translation.archive_deleted_blocked

      tests
        denies when self.deleted_at != nil
        allows when self.deleted_at = nil

    rule "enterprise customers require owner before activation"
      deny Customer.activate when self.tier = CustomerTier.enterprise AND self.owner = nil
      message @translation.enterprise_owner_required

      tests
        denies when self.tier = enterprise AND self.owner = nil
        allows when self.tier = enterprise AND self.owner != nil
        allows when self.tier = free AND self.owner = nil
        allows when self.tier = pro AND self.owner = nil

    event_group customer_* on Customer
      payload
        customer_id = id
        org_id = org.id
        by_id = ctx.user.id when @actor.user

      event created
        email: @semantic.Email @pii.contact
        source: CustomerSource

      event status_changed
        from: CustomerStatus
        to: CustomerStatus

      event activated

      event paused

      event archived

      event reassigned
        to_owner_id: ID

      event.trace score_recomputed
        score: Integer
        reason: Text

  policies
    capture_lead: @scope.public
    create: @role.admin, @role.sales
    update: @role.admin, @role.sales
      when_denied @translation.customer_update_admin_only
    delete: @role.admin
    read: @scope.same_org
    global_read: @role.admin

    fields Customer
      email
        read: @scope.same_org
        write: @role.admin, @role.sales

      score
        read: @role.admin, @role.sales_manager
        write: @actor.system

      external_id
        read: @role.admin, @role.integrations_admin
        write: @actor.system, @role.integrations_admin

  errors
    default hide
    expose client 4xx message, code
    expose client 5xx code

    policy_denied message @translation.customer_signin_required
    validation_failed message @translation.customer_invalid_input

  translation
    catalog "./i18n/customer.<locale>.json"

    key archive_archived_blocked
      pt-BR "Não é possível reatribuir um cliente arquivado"
      en-US "Cannot reassign an archived customer"

    key archive_deleted_blocked
      pt-BR "Não é possível arquivar um cliente excluído"
      en-US "Cannot archive a deleted customer"

    key enterprise_owner_required
      pt-BR "Clientes enterprise exigem um proprietário antes da ativação"
      en-US "Enterprise customers require an owner before activation"

    key customer_update_admin_only
      pt-BR "Apenas administradores ou vendedores podem atualizar este cliente."
      en-US "Only admins or sales reps can update this customer."

    key customer_signin_required
      pt-BR "Para gerenciar clientes, entre na sua conta primeiro."
      en-US "Please sign in to manage customers."

    key customer_invalid_input
      pt-BR "Os dados do cliente estão incompletos ou incorretos."
      en-US "The customer information is missing or incorrect."

    key capture_lead_signin_required
      pt-BR "Para capturar um lead, entre na sua conta primeiro."
      en-US "Please sign in to capture a lead."

    key customer_tier_free
      pt-BR "Gratuito"
      en-US "Free"

    key customer_tier_pro
      pt-BR "Pro"
      en-US "Pro"

    key customer_tier_pro_hint
      pt-BR "Plano para equipes em crescimento"
      en-US "Plan for growing teams"

    key customer_tier_enterprise
      pt-BR "Enterprise"
      en-US "Enterprise"

    key customer_tier_enterprise_hint
      pt-BR "Plano com controles e suporte avançados"
      en-US "Plan with advanced controls and support"

  command capture_lead
    input
      name: Text required
      email: @semantic.Email @pii.contact required
    policy @policy.capture_lead
      when_denied @translation.capture_lead_signin_required
    rate_limit "10 per minute per ip"
    creates Customer
      name = input.name
      email = input.email
      status = CustomerStatus.lead
      tier = CustomerTier.free
      source = CustomerSource.manual
      owner = nil
    emits customer_created from creates
    invalidates
      query.list
      query.global_search

  command create
    input
      name: Text required
      email: @semantic.Email @pii.contact required
      tier: CustomerTier required
      source: CustomerSource required
    policy @policy.create
    rate_limit "30 per hour per ip"
    creates Customer
      name = input.name
      email = input.email
      tier = input.tier
      source = input.source
      owner = ctx.user
    emits customer_created from creates
    invalidates
      query.list
      query.global_search

  command reassign
    previously migrated assign_owner
    deprecated since "2026.04" replacement capture_lead sunset "2026-12-31"
    route id: ID
    input
      owner_id: User.ID required
    let resolved_owner = user.query.by_id(id: input.owner_id)
    policy @policy.update
    rate_limit "60 per minute per user"
    audit actor, target.id, input.owner_id
      emit_to audit_log
    approval
      required_when target.tier = enterprise
      by @role.admin
      timeout "24h"
      then deny
    updates Customer
      owner = resolved_owner
    emits customer_reassigned
      to_owner_id = input.owner_id
    invalidates
      query.list
      query.by_id(id: route.id)

    tests
      denies when target.status = archived
      allows when target.status = active
      allows when target.status = paused

  command update_tier
    route id: ID
    input
      tier: CustomerTier required
    policy @policy.update
    rate_limit "30 per minute per user"
    updates Customer
      tier = input.tier
    invalidates
      query.list
      query.by_id(id: route.id)

  command activate
    route id: ID
    input
      owner_id: User.ID required
    let resolved_owner = user.query.by_id(id: input.owner_id)
    policy @policy.update
    rate_limit "30 per minute per user"
    # The command owns the write; the lifecycle owns the state edge.
    # Backend gates on `Customer.status == activate.from` (lead), runs the
    # update, then advances `status = activate.to` (active) in one txn.
    triggers transition activate
    updates Customer
      owner = resolved_owner
    emits customer_activated
    invalidates
      query.list
      query.by_id(id: route.id)

  command archive_customer
    route id: ID
    input
      reason: Text required
    policy @policy.update
    rate_limit "10 per minute per user"
    # Multi-approver sign-off: a compliance reviewer then an admin must
    # approve in strict order; on timeout/denial the request escalates.
    approval
      required_when target.tier = enterprise
      chain [@role.sales_manager, @role.admin] sequential
      timeout "24h"
      then escalate
    # Records the archive into the append-only ledger owned by
    # `customer_audit` (cross-feature, reachable via `uses`).
    audit actor, target.id, input.reason
      materialize @feature.customer_audit.OperationLog
    # Advances the lifecycle (active -> archived) without writing `status`.
    triggers transition archive
    updates Customer
      reminder_lead_days = 0
    emits customer_archived
    invalidates
      query.list
      query.by_id(id: route.id)

  command reorder_notes
    route id: ID
    input
      ordered_ids: JSON required
    policy @policy.update
    rate_limit "30 per minute per user"
    reorder CustomerNote by position
    invalidates
      query.by_id(id: route.id)

  report monthly_audit
    input
      period_start: Date required
      period_end: Date required
    source customer.query.list
    columns
      id from row.id
      name from row.name
      tier from row.tier label "Plano"
      ltv from @fn.lifetime_value(row.id) label "Valor de vida"
      created_at from row.created_at format "yyyy-mm-dd"
    formats csv, xlsx
    storage object_storage.files
    visibility signed
    signed_ttl 1h
    filename "monthly_audit_{ctx.now:yyyymm}.{format}"
    policy @policy.global_read
    rate_limit "10 per hour per user"
    audit actor, ctx.now, source.params

  agent summarize_customer
    input
      customer_id: Customer.ID required
      prompt: Text required
    context customer.query.by_id(id: input.customer_id)
    policy @policy.read
    rate_limit "20 per hour per user"
    output stream Text
    model @llm.default
    temperature 0
    seed 1
    max_tokens 1024
    top_p 0.9
    prompt "./prompts/summarize_customer.md"
    safety @validator.pii_scrub
    tools
      customer.query.lookup.by_id
      customer.query.list
    expose http
      method POST
      path "/api/customers/:customer_id/summary"
      route customer_id: Customer.ID
    evals
      case mentions_active_when_active
        requires customer.status = active
        requires output contains "active"

      case redacts_email
        requires customer.email = "ada@example.com"
        forbids output contains @semantic.Email

      case uses_lookup_when_id_known
        requires input.customer_id = "cus_123"
        requires tools.calls includes customer.query.lookup.by_id

      case golden_summary_quality
        golden "./evals/summarize_customer_golden.jsonl" min_score 0.85

  agent classify_intent
    input
      message: Text required
    policy @policy.read
    rate_limit "60 per minute per user"
    output discriminator CustomerStatus
    model @llm.classifier
    temperature 0
    seed 42
    max_tokens 16
    prompt "./prompts/classify_intent.md"

  job recompute_score_after_invoice
    trigger event billing.invoice_paid
    tenant_from payload.org_id
    idempotency by envelope.id
    target query.by_id(id: payload.customer_id)
    let new_score = @fn.risk_score(target)
    updates Customer
      score = new_score
    emits customer_score_recomputed
      score = new_score
      reason = "invoice_paid"

  job recompute_scores
    trigger schedule "0 2 * * *"
    fanout tenants org
    idempotency by tenant.org_id, schedule.day
    retry 3 backoff exponential
    handler "./jobs/recompute_scores.go"

  tenant_migration backfill_customer_score
    target tenants org
    idempotency by tenant.org_id
    retry 3 backoff exponential
    timeout "5m"
    handler "./migrations/backfill_customer_score.go"

  channel customer_activity
    tenant_from org
    policy @policy.read
    payload CustomerActivityEvent

  extensions
    client status_cell: CellRenderer[Customer]
    client score_cell: CellRenderer[Customer]
    client owner_cell: CellRenderer[Customer]
    client activity_timeline: ViewBlock[Customer]

    hook before_create: Hook[CreateCustomer]
    hook after_archive: Hook[ArchiveCustomer]
    fn risk_score: Function[Customer, Integer]
    fn lifetime_value: Function[ID, Integer] at "./domain/lifetime_value.go"
    fn next_review_rule: Function[Date, Date] at "./domain/next_review_rule.go"
    query_modifier query_scope_modifier: QueryModifier[Customer]

    validator tier_check: Validator[Customer.tier] at "./hooks/validate_tier.go"

  escape_route "/admin/customer-debug"
    at "./pages/customer_debug.tsx"
    policy @role.admin
    tenant org

feature customer_auth
  purpose "Customer-facing login, sessions, OAuth, MFA, and account access."

  non_goals
    delegated_to
      user: "staff authentication"
      customer: "customer lifecycle ownership"

  knowledge lazuli-way

  defaults
    tenancy org
    timestamps

  uses org
  uses customer version v1

  domain
    enum AuthProvider
      password
      google
      magic_link

    resource CustomerSession
      customer: Customer required on_delete restrict
      refresh_token_hash: @cap.Hashed(algorithm:argon2id) required
      provider_access_token: @cap.Encrypted(key:@key.tenant) @pii.credential optional
      provider: AuthProvider required
      expires_at: DateTime required
      refresh_expires_at: DateTime optional
      parent_session_id: ID optional
      theft_detected_at: DateTime optional
      retention 30d then delete

    resource CustomerMfaConfig
      customer: Customer required on_delete restrict
      verified_at: DateTime required

    resource CustomerPasswordReset
      customer: Customer required on_delete cascade
      token: @cap.Token(ttl:1h,single_use:true,store:hashed) required
      requested_at: DateTime required

    query.list active_sessions
      modifier @query_modifier.active_session_scope

      params
        customer_id: ID

      filters
        customer.id = params.customer_id
        expires_at > ctx.now

    event customer_logged_in
      customer_id: ID
      session_id: ID
      provider: AuthProvider

    event customer_mfa_enabled
      customer_id: ID
      by_id: ID

  policies
    login: @scope.public
    update: @scope.same_org
    read: @scope.same_org

    fields CustomerSession
      refresh_token_hash
        read: @actor.system
        write: @actor.system

      provider_access_token
        read: @actor.system
        write: @actor.system

    fields CustomerPasswordReset
      token
        read: @actor.system
        write: @actor.system

  auth
    public contract identity as v1
    identity Customer.email

    password
      algorithm argon2id
      hash @fn.hash_customer_password
      verify @fn.verify_customer_password
      rate_limit "5 per 10 minutes"

    oauth google
      adapter @adapter.google_oauth

    mfa totp
      enroll @fn.enroll_customer_totp
      verify @validator.verify_customer_totp

    sessions
      resource CustomerSession
      ttl "7 days"
      access_ttl "15 minutes"
      rotation
        refresh_ttl "30 days"
        grace "30 seconds"
        theft_detection_action revoke_session_family

  command login
    input
      email: @semantic.Email
      password: Text
    policy @policy.login
    rate_limit "5 per 10 minutes per ip"
    returns Text
    emits customer_logged_in

  command enable_mfa
    route customer_id: ID from ctx.customer.id
    input
      totp_code: Text required
    target customer.query.by_id(id: route.customer_id)
    validate @validator.verify_customer_totp(customer_id: route.customer_id, code: input.totp_code)
    policy @policy.update
    rate_limit "10 per minute per user"
    creates CustomerMfaConfig
      customer = target
      verified_at = ctx.now
    emits customer_mfa_enabled

  extensions
    fn hash_customer_password: Function[Text, @cap.Hashed(algorithm:argon2id)] at "./auth/hash_customer_password.go"
    fn verify_customer_password: Function[PasswordVerifyInput, PasswordVerifyResult] at "./auth/verify_customer_password.go"
    adapter google_oauth: IntegrationAdapter[GoogleOAuth] at "./integrations/google_oauth.go"
    fn enroll_customer_totp: Function[Customer, TotpEnrollment] at "./auth/enroll_customer_totp.go"
    validator verify_customer_totp: Validator[TotpVerifyInput] at "./auth/verify_customer_totp.go"
    query_modifier active_session_scope: QueryModifier[CustomerSession] at "./queries/active_session_scope.go"

feature customer_tags
  purpose "Customer tag taxonomy and tag assignments with assignment metadata."

  non_goals
    delegated_to
      customer: "customer lifecycle ownership"
    out_of_scope
      generic_taxonomy: "generic taxonomy system"

  defaults
    tenancy org
    timestamps

  uses org, user, customer

  domain
    resource CustomerTag
      name: Text required
      color: Text optional

    resource CustomerTagAssignment
      customer: Customer required on_delete cascade
      tag: CustomerTag required on_delete restrict
      added_by: User required
      added_at: DateTime required

    constraints
      unique name per org
      unique customer, tag per org

    query.list list_tags
      order name asc

    query.lookup tag_by_id by id: ID

    query.list assignments_for_customer
      params
        customer_id: ID

      filters
        customer.id = params.customer_id

      order added_at desc

    query.lookup assignment_by_customer_tag
      params
        customer_id: ID
        tag_id: ID

      filters
        customer.id = params.customer_id
        tag.id = params.tag_id

    query.list customers_by_tag
      params
        tag_id: ID

      filters
        tag.id = params.tag_id

      order added_at desc
      paginate 100

    event_group tag_assignment_* on CustomerTagAssignment
      payload
        customer_id = customer.id
        tag_id = tag.id
        org_id = org.id
        by_id = ctx.user.id when @actor.user

      event created

      event removed

    event tag_created
      tag_id: ID
      org_id: ID

  policies
    create: @role.admin, @role.sales_ops
    update: @role.admin, @role.sales_ops
    delete: @role.admin
    read: @scope.same_org

  command create_tag
    input
      name: Text required
      color: Text optional
    policy @policy.create
    rate_limit "30 per minute per user"
    creates CustomerTag
      name = input.name
      color = input.color
    emits tag_created

  command assign_tag
    input
      customer_id: ID required
      tag_id: ID required
    target customer.query.by_id(id: input.customer_id)
    let resolved_tag = query.tag_by_id(id: input.tag_id)
    policy @policy.update
    rate_limit "60 per minute per user"
    creates CustomerTagAssignment
      customer = target
      tag = resolved_tag
      added_by = ctx.user
      added_at = ctx.now
    emits tag_assignment_created

  command remove_tag
    input
      customer_id: ID required
      tag_id: ID required
    target query.assignment_by_customer_tag(customer_id: input.customer_id, tag_id: input.tag_id)
    policy @policy.update
    rate_limit "60 per minute per user"
    deletes CustomerTagAssignment
    emits tag_assignment_removed

  extensions
    client tag_editor: ViewBlock[Customer]
    hook before_assign_tag: Hook[AssignCustomerTag]

feature customer_import
  purpose "Customer CSV uploads, CRM webhook ingestion, row validation, and async processing."

  non_goals
    delegated_to
      customer: "customer lifecycle ownership"
    out_of_scope
      generic_etl: "generic ETL platform"

  defaults
    tenancy org
    timestamps
    policy_for jobs, webhooks: @actor.system

  uses org, user, customer

  requires integration crm: CRMProvider

  domain
    enum ImportStatus
      uploaded
      validating
      processing
      completed
      failed

    resource CustomerImportBatch
      uploaded_by: User required
      file: @cap.File(max_size:25mb,accept:text/csv,visibility:private) required
      status: ImportStatus = uploaded
      total_rows: Integer = 0
      valid_rows: Integer = 0
      failed_rows: Integer = 0

    resource CustomerImportRow
      batch: CustomerImportBatch required
      row_number: Integer required
      raw: JSON required
      error: Text optional
      validates @validator.row_check

    query.lookup by_id by id: ID

    query.list rows
      params
        batch_id: ID

      filters
        batch.id = params.batch_id

      order row_number asc
      paginate 100

    event customer_import_uploaded
      batch_id: ID
      org_id: ID
      uploaded_by_id: ID

    event customer_import_completed
      batch_id: ID
      valid_rows: Integer
      failed_rows: Integer

    event.trace customer_webhook_received
      level warn
      external_id: Text
      org_id: ID

  policies
    import: @role.admin, @role.sales_ops
    read: @scope.same_org
    delete: @role.admin

  command upload
    input file
    policy @policy.import
    rate_limit "20 per hour per user"
    creates CustomerImportBatch
      file = input.file
      uploaded_by = ctx.user
    emits customer_import_uploaded

  job process_import
    trigger event customer_import_uploaded
    queue customer_imports
    tenant_from payload.org_id
    idempotency by payload.batch_id
    retry 3 backoff exponential
    calls crm.normalize_import_batch
      batch_id = payload.batch_id
      org_id = payload.org_id
    timeout "30s"
    handler "./jobs/process_import.go"
    emits customer_import_completed

  webhook crm_customer_upsert
    path "/webhooks/crm/customer-upsert"
    payload from webhook_events.crm_customer_upsert
    verify hmac sha256
      secret env.CRM_WEBHOOK_SECRET
      header "X-CRM-Signature"
    tenant_from payload.org_id
    idempotency by payload.org_id, payload.external_id
    retry 5 backoff exponential
    replay allow within "24h"
    dlq emit customer_webhook_dead_lettered
    handler "./integrations/upsert_customer_from_crm.go" returns Customer
    emits customer_webhook_received
    emits customer_webhook_dead_lettered

  extensions
    client import_history: ViewBlock[Customer]
    client import_progress: ViewBlock[CustomerImportBatch] at "./ui/import_progress.tsx"

    validator row_check: Validator[CustomerImportRow] at "./domain/validate_row.go"

  escape_route "/admin/customer-imports"
    at "./pages/customer_imports.tsx"
    policy @role.admin
    tenant org

feature customer_outreach
  purpose "Send customer lifecycle outreach from events without owning storage."

  non_goals
    delegated_to
      notification: "notification persistence"
      customer: "customer lifecycle ownership"

  defaults
    policy_for jobs, webhooks: @actor.system

  uses customer

  domain
    event.trace welcome_email_sent
      customer_id: ID

    event.trace archive_survey_sent
      customer_id: ID

  policies
    notify: @actor.system

  notification welcome_email
    channel email
    recipient target.email
    trigger event customer.customer_activated
    tenant_from payload.org_id
    idempotency by envelope.id
    retry 3 backoff exponential
    template "./outreach/welcome_email.mjml"
    policy @policy.notify
    emits welcome_email_sent
    digest
      every "15 minutes"
      group_by customer_id
      max_size 50
      template_strategy merge
    throttle
      max_per "1 hour"
      per_recipient
      per_channel
      burst 3

  notification archive_survey
    channel email, in_app
    recipient target.email
    trigger event customer.customer_archived
    tenant_from payload.org_id
    idempotency by envelope.id
    retry 3 backoff exponential
    template "./outreach/archive_survey.mjml"
    policy @policy.notify
    emits archive_survey_sent

feature account
  purpose
    Identity owner for application users (canonical, cross-feature).

  uses org

  domain
    resource User
      email: @semantic.Email @pii.contact required unique
      name: Text required
      role: Text optional

      retention forever then anonymize

  policies
    read: @scope.same_org
    update: @role.admin

    fields User
      email
        read: @scope.same_org
        write: @role.admin

feature customer_audit
  purpose "Append-only audit ledger that customer write-commands materialize into."

  non_goals
    delegated_to
      customer: "customer lifecycle ownership"
    out_of_scope
      generic_audit_pipeline: "cross-domain audit aggregation"

  defaults
    tenancy org
    timestamps

  uses org, user

  domain
    enum OperationKind
      reassign
      archive

    # Append-only ledger: customer commands sink their audit record here
    # via `audit ... materialize @feature.customer_audit.OperationLog`.
    resource OperationLog
      append_only
      actor: User required
      operation: OperationKind required
      target_id: ID required
      occurred_at: DateTime required
      detail: JSON optional

    query.list ledger
      params
        operation: OperationKind optional

      filters
        operation when params.operation

      paginate 100

    query.lookup entry_by_id by id: ID

    rule "audit ledger entries cannot be deleted"
      deny OperationLog.delete when self.detail != nil
      message "Audit log entries are immutable"

      tests
        denies when self.detail != nil
        allows when self.detail = nil

  policies
    read: @role.admin, @role.compliance
