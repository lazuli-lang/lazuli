# Full capsule application manifest.
# Declares the provider-neutral operational contract for the Lazuli runtime.

app AcmeCRM
  title "Acme CRM"
  version "0.1.0"
  default_timezone "America/Sao_Paulo"

  locale
    default "pt-BR"
    supported "pt-BR", "en-US"
    fallback "en-US" -> "pt-BR"
  actor_query "customer.query.by_id"
  auth_failed_redirect public_login
  route_guard
    on_unauthenticated redirect "/login"
    on_unauthorized redirect "/not-found"
  not_found public_not_found

  uses
    customer
    customer_auth
    customer_tags
    customer_import
    customer_outreach

  bindings
    customer_import.crm = integrations.crm

  targets
    backend go
    web react
    mobile expo

  environments
    local
    staging
    production

  env
    server AUTH_REFRESH_SECRET: Secret required

  capabilities
    secret_provider env.AUTH_REFRESH_SECRET

  urls
    web local "http://localhost:3000"
    api local "http://localhost:8080"
    web production "https://app.acme.example"
    api production "https://api.acme.example"

  cors
    allow_origins production "https://app.acme.example"
    allow_origins local "http://localhost:3000"
    allow_credentials true
    max_age "1h"

  architecture
    mode modular_monolith
    service_ready true
    enforce_service_boundaries true

  services
    service identity
      owns customer_auth
      exposes
        command customer_auth.command.login
        command customer_auth.command.enable_mfa
      publishes customer_auth.customer_*

    service crm
      owns customer, customer_tags, customer_import, customer_outreach
      exposes
        query customer.query.list
        query customer.query.by_id
        command customer.command.create
        command customer.command.reassign
        report customer.report.monthly_audit
      publishes customer.customer_*, customer_tags.tag_assignment_*, customer_import.customer_import_*, customer_outreach.*
      consumes billing.invoice_paid

  communication
    internal sync rpc
    external http
    async event_bus
    propagate actor, tenant, trace_id, request_id
    timeout default "2s"
    retry default 2 backoff exponential

  runtime
    unit api
      serves queries, commands, webhooks, apis
      healthcheck "/healthz"
      readiness "/readyz"
      locale_negotiate
        source accept_language
        strategy best_match
        fallback "pt-BR"

    unit web
      serves surfaces web

    unit worker
      runs jobs *

    unit scheduler
      runs schedules *

  deploy
    migrations before_deploy
    migration_lock required
    destructive_migrations require_approval
    rollback on_failed_healthcheck
    strategy rolling
    lock_timeout "30s"
    pre_migration_hook "./hooks/migration_pre.sh"
    post_migration_hook "./hooks/migration_post.sh"
    checkpoint baseline "./checkpoints/full-capsule.snapshot.json"

  logging
    level info
    format json
    redact pii

  tracing
    propagate true
    sample_rate 0.1

  # Encryption bucket cycle — one binding per `@key.<scope>` referenced
  # by `@cap.Encrypted` / `@cap.E2ee` field sites in this capsule.
  # `Customer.external_id` and `CustomerSession.provider_access_token`
  # are both `@cap.Encrypted(key:@key.tenant)`; the binding below ties
  # that scope to a per-tenant env var template.
  # See `docs/proposals/encryption-vocab.md`.
  encryption
    key @key.tenant
      source env.CRYPT_KEY_TENANT_{tenant_id}
      algorithm aes_256_gcm
      rotation manual
