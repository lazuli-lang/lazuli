# Full capsule application manifest.
# Declares the provider-neutral operational contract for the Lazuli runtime.

app AcmeCRM
  title "Acme CRM"
  version "0.1.0"
  default_locale "pt-BR"
  default_timezone "America/Sao_Paulo"
  auth_failed_redirect public_login
  not_found public_not_found

  uses
    customer
    customer_auth
    customer_tags
    customer_import
    customer_outreach

  bindings
    customer_import.crm = integrations.crm

  targets
    backend go
    web react
    mobile expo

  environments
    local
    staging
    production

  urls
    web local "http://localhost:3000"
    api local "http://localhost:8080"
    web production "https://app.acme.example"
    api production "https://api.acme.example"

  cors
    allow_origins production "https://app.acme.example"
    allow_origins local "http://localhost:3000"
    allow_credentials true
    max_age "1h"

  architecture
    mode modular_monolith
    service_ready true
    enforce_service_boundaries true

  services
    service identity
      owns customer_auth
      exposes
        command customer_auth.command.login
        command customer_auth.command.enable_mfa
      publishes customer_auth.customer_*

    service crm
      owns customer, customer_tags, customer_import, customer_outreach
      exposes
        query customer.query.list
        query customer.query.by_id
        command customer.command.create
        command customer.command.reassign
        api customer.api.customer_export
      publishes customer.customer_*, customer_tags.tag_assignment_*, customer_import.customer_import_*, customer_outreach.*
      consumes billing.invoice_paid

  communication
    internal sync rpc
    external http
    async event_bus
    propagate actor, tenant, trace_id, request_id
    timeout default "2s"
    retry default 2 backoff exponential

  runtime
    unit api
      serves queries, commands, webhooks, apis
      healthcheck "/healthz"
      readiness "/readyz"

    unit web
      serves surfaces web

    unit worker
      runs jobs *

    unit scheduler
      runs schedules *

  deploy
    migrations before_deploy
    migration_lock required
    destructive_migrations require_approval
    rollback on_failed_healthcheck

  logging
    level info
    format json
    redact pii

  tracing
    propagate true
    sample_rate 0.1
