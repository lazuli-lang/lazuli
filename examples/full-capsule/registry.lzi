# Full capsule package registry.
# Catalogs provider-neutral capabilities and bindings available to app.lzi.

registry
  env
    group customer_import
      server CRM_WEBHOOK_SECRET: Secret required in production
    group public_clients
      client PUBLIC_APP_URL: Url required
      mobile EXPO_PUBLIC_API_URL: Url required
    # Encryption bucket cycle — per-tenant key envelope. The
    # `{tenant_id}` template marker declares the registry pattern; the
    # runtime substitutes the active tenant id at resolution time so
    # each tenant resolves to its own env var (e.g.
    # `CRYPT_KEY_TENANT_42`). One env-schema entry covers all tenants.
    group encryption
      server CRYPT_KEY_TENANT_{tenant_id}: Secret required

  capabilities
    database postgres
    queue background_jobs
    object_storage files
    mailer transactional
    event_bus internal
    cache shared
    tracing optional
    integration crm

  packs
    customer_import from @runtime/customer-import
      version "0.1.0"
      provides feature customer_import
      requires integration crm: CRMProvider

  integrations
    crm: CRMProvider
      adapter @adapter.crm
      environments sandbox, production
      credentials platform
        webhook_secret env.CRM_WEBHOOK_SECRET

  webhook_events
    crm_customer_upsert
      external_id: Text required
      org_id: ID required
      email: @semantic.Email @pii.contact optional
      payload_version: Text required
      received_at: Timestamp required
