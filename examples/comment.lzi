# Comment fixture — typed-FK shape (canonical answer to "comments on X").
#
# Scope: comments on issues. The polymorphic `target: enum + target_id:
# ID` shape was retired here as part of the 2026-05-14 vocab audit
# (BLOCK -> PASS); the prior fixture is preserved at
# `examples/anti-patterns/comment-polymorphic-target.lzi` so readers
# can compare typed vs. untyped polymorphic FK.
#
# If "comments on customers" is needed later, add a sibling resource
# `CustomerComment` (typed FK to Customer) and a parallel command +
# query rather than reintroducing an enum discriminator. When the
# `union` block lands (proposal: doctor-vocabulary-lints §VOCAB-UNION-001)
# the two resources collapse into a discriminated union.

feature comment
  purpose "Threaded comments on issues, with typed FK to the issue and self-referential replies."

  non_goals
    out_of_scope
      rich_text_editor: "rich text editor implementation"
      activity_timeline: "cross-feature activity timeline ownership"
      multi_target_comments: "comments on resources other than Issue (add a sibling resource per target)"

  uses org, user, issue

  domain
    resource Comment
      tenancy org
      author: User required
      issue: Issue required
      parent: Comment optional
      body: Text required

      soft_delete
      timestamps

    resource CommentMention
      tenancy org
      comment: Comment required
      mentioned_user: User required
      added_by: User required
      added_at: DateTime required

    query.list for_issue
      params
        issue_id: ID

      filters
        issue.id == params.issue_id

      order created_at asc

    query.list replies
      params
        parent_id: ID

      filters
        parent.id == params.parent_id

      order created_at asc

    event comment_created
      payload Comment

  policies
    author: @scope.same_org
    edit: @scope.owner, @role.admin
    remove: @scope.owner, @role.admin
    view: @scope.same_org

  command create
    input
      issue_id: ID
      parent_id: ID optional
      body: Text
    policy @policy.author
    rate_limit "60 per minute per user"
    creates Comment
      issue.id = input.issue_id
      parent.id = input.parent_id
      body = input.body
      author = ctx.user
    audit default
    emits comment_created from creates

  surface web admin
    view issue_thread SidePanel
      source query.for_issue(issue_id: route.issue_id)
      block @client.thread_view

  extensions
    client thread_view: ViewBlock[Comment]
