# Comment pressure test.
# Exercises rich relations and target-specific comment lists.
# Design fixture only; parser and codegen coverage may lag this surface.

feature comment
  purpose "Threaded comments on issues and customers with explicit target resources."

  non_goals
    anti_pattern.rich_text_editor: "rich text editor implementation"
    anti_pattern.activity_timeline: "cross-feature activity timeline ownership"

  uses org, user, issue, customer

  domain
    enum CommentTarget
      issue
      customer

    resource Comment
      tenancy org
      author: User required
      target: CommentTarget required
      target_id: ID required
      parent: Comment optional
      body: Text required

      soft_delete
      timestamps

    resource CommentMention
      tenancy org
      comment: Comment required
      mentioned_user: User required
      added_by: User required
      added_at: DateTime required

    query.list for_issue
      params
        issue_id: ID

      filters
        target = CommentTarget.issue
        target_id = params.issue_id

      order created_at asc

    query.list for_customer
      params
        customer_id: ID

      filters
        target = CommentTarget.customer
        target_id = params.customer_id

      order created_at asc

    event comment_created
      comment_id: ID
      org_id: ID
      author_id: ID
      target: CommentTarget
      target_id: ID

  policies
    create: @scope.same_org
    update: @scope.owner, @role.admin
    delete: @scope.owner, @role.admin
    read: @scope.same_org

  command create_for_issue
    input
      issue_id: ID
      body: Text
    policy create
    creates Comment
      target = CommentTarget.issue
      target_id = input.issue_id
      body = input.body
      author = ctx.user
    emits comment_created

  command create_for_customer
    input
      customer_id: ID
      body: Text
    policy create
    creates Comment
      target = CommentTarget.customer
      target_id = input.customer_id
      body = input.body
      author = ctx.user
    emits comment_created

  surface web admin
    view issue_thread SidePanel
      source query.for_issue(issue_id: route.issue_id)
      block @client.thread_view

    view customer_thread SidePanel
      source query.for_customer(customer_id: route.customer_id)
      block @client.thread_view

  extensions
    client thread_view: ViewBlock[Comment]
    fn extract_mentions: Function[Text, User[]]
