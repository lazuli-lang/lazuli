# Billing pressure test.
# Exercises inbound webhooks, invoices, retries, and scheduled jobs.
# Provider-neutral: payment gateways are wired through an abstract integration slot.
# Design fixture only; parser and codegen coverage may lag this surface.

# PG.PRE.2 / PG.F — Plan & Gate vocabulary exercise. The package
# author would normally split these blocks across `app.lzi` (anchor)
# and `registry.lzi` (catalog); inline here to keep the fixture file
# self-contained so doctor's plan-gate cross-checks have a single
# source of truth.

plan free
  features list_invoices, lookup_invoice
  limits invoices_per_month 50

plan pro
  features list_invoices, lookup_invoice, create_invoice
  limits invoices_per_month 5000

plan enterprise
  features list_invoices, lookup_invoice, create_invoice
  limits invoices_per_month unlimited

feature billing
  purpose "Invoices, payment-gateway webhooks, retryable billing events, and invoice status."

  non_goals
    delegated_to
      customer: "customer lifecycle ownership"
    out_of_scope
      tax_engine: "tax calculation engine - external integration"

  defaults
    policy_for jobs, webhooks: @actor.system

  uses org, customer

  requires integration payments: PaymentGateway

  domain
    enum InvoiceStatus
      draft
      open
      paid
      void
      failed

    resource Invoice
      tenancy org
      customer: Customer required
      number: Text required
      amount_cents: Integer required
      currency: Text required
      issued_at: Date required
      external_invoice_id: Text optional
      external_provider: Text optional

      soft_delete
      timestamps

      lifecycle status
        state draft initial
        state open
        state paid terminal
        state failed terminal
        state void terminal

        transition open
          from draft
          to open
          policy @policy.edit
          audit default
          emits invoice_status_changed

        transition mark_paid
          from open
          to paid
          policy @policy.edit
          audit default
          emits invoice_paid, invoice_status_changed

        transition fail
          from open
          to failed
          policy @policy.edit
          audit default
          emits invoice_status_changed

        transition void
          from open
          to void
          policy @policy.edit
          audit default
          emits invoice_status_changed

    resource BillingWebhook
      tenancy org
      adapter: Text required
      provider_event_id: Text required
      received_at: DateTime required
      processed_at: DateTime optional
      failed_at: DateTime optional

      timestamps

    constraints
      unique number per org
      unique provider_event_id per adapter

    query.list list
      params
        status: InvoiceStatus optional
        customer: Customer optional

      filters
        status when params.status
        customer when params.customer

      paginate 50

    query.lookup by_id by id: ID

    event invoice_created
      payload Invoice

    event invoice_paid
      payload Invoice
      external_provider: Text optional

    event billing_webhook_failed
      payload BillingWebhook

  policies
    author: @role.admin, @role.billing_admin
    edit: @role.billing_admin
    view: @scope.same_org
    remove: @role.billing_admin

  command create
    input customer, amount_cents, currency, issued_at
    gate behind plan.feature: create_invoice
    gate quota plan.limit: invoices_per_month
    write_window by input.issued_at within billing.open_period
    policy @policy.author
    rate_limit "30 per minute per user"
    creates Invoice
      customer = input.customer
      amount_cents = input.amount_cents
      currency = input.currency
      issued_at = input.issued_at
      number = @fn.next_invoice_number(ctx.user.org)
    audit default
    emits invoice_created from creates

  job retry_failed_webhooks
    trigger schedule "*/5 * * * *"
    fanout tenants org
    idempotency by tenant.org_id, schedule.minute
    retry 3 backoff exponential
    handler "./jobs/retry_failed_webhooks.go"
    emits billing_webhook_failed

  webhook payment_invoice_paid
    path "/webhooks/payments/invoice-paid"
    verify "./integrations/payment_invoice_paid.go"
    tenant_from payload.org_id
    idempotency by payload.org_id, payload.provider_event_id
    handler "./integrations/record_payment_invoice_paid.go" returns BillingWebhook
    emits invoice_paid

  surface web admin
    view list Table
      source query.list
      columns number, customer, amount_cents, currency, status, created_at
      filter status, customer

    view detail SidePanel
      source query.by_id(id: route.id)

  extensions
    fn next_invoice_number: Function[Org, Text]
