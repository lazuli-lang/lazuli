# Billing pressure test.
# Exercises inbound webhooks, invoices, retries, and scheduled jobs.
# Design fixture only; parser and codegen coverage may lag this surface.

feature billing
  purpose "Invoices, Stripe payment webhooks, retryable billing events, and invoice status."

  non_goals
    delegated_to
      customer: "customer lifecycle ownership"
    out_of_scope
      tax_engine: "tax calculation engine - external integration"

  defaults
    policy_for jobs, webhooks: @actor.system

  uses org, customer

  domain
    enum InvoiceStatus
      draft
      open
      paid
      void
      failed

    resource Invoice
      tenancy org
      customer: Customer required
      number: Text required
      amount_cents: Integer required
      currency: Text required
      status: InvoiceStatus = draft
      stripe_invoice_id: Text optional

      soft_delete
      timestamps

    resource BillingWebhook
      tenancy org
      provider: Text required
      provider_event_id: Text required
      received_at: DateTime required
      processed_at: DateTime optional
      failed_at: DateTime optional

      timestamps

    constraints
      unique number per org
      unique provider_event_id per provider

    query.list list
      params
        status: InvoiceStatus optional
        customer: Customer optional

      filters
        status when params.status
        customer when params.customer

      order created_at desc
      paginate 50

    query.lookup by_id by id: ID

    event invoice_created
      invoice_id: ID
      customer_id: ID
      org_id: ID

    event invoice_paid
      invoice_id: ID
      customer_id: ID
      org_id: ID
      stripe_invoice_id: Text

    event billing_webhook_failed
      webhook_id: ID
      provider_event_id: Text

  policies
    create: @role.admin, @role.billing_admin
    update: @role.billing_admin
    read: @scope.same_org
    delete: @role.billing_admin

  command create
    input customer, amount_cents, currency
    policy @policy.create
    creates Invoice
      customer = input.customer
      amount_cents = input.amount_cents
      currency = input.currency
      number = @fn.next_invoice_number(ctx.user.org)
    emits invoice_created

  workflow status on Invoice.status
    policy @policy.update
    emits invoice_status_changed

    open: draft -> open
    mark_paid: open -> paid
      emits invoice_paid
    fail: open -> failed
    void: open -> void

  job retry_failed_webhooks
    trigger schedule "*/5 * * * *"
    handler "./jobs/retry_failed_webhooks.go"
    emits billing_webhook_failed

  webhook stripe_invoice_paid
    path "/webhooks/stripe/invoice-paid"
    verify "./integrations/stripe.go"
    idempotency by payload.provider_event_id
    handler "./integrations/record_stripe_invoice_paid.go" returns BillingWebhook
    emits invoice_paid

  surface web admin
    view list Table
      source query.list
      columns number, customer, amount_cents, currency, status, created_at
      filter status, customer

    view detail SidePanel
      source query.by_id(id: route.id)

  extensions
    fn next_invoice_number: Function[Org, Text]
