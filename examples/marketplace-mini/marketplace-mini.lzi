feature account
  purpose "User identity for the marketplace mini fixture."

  domain
    resource User
      email: Email @pii.contact required unique
      name: Text required
      retention 7y then anonymize

  policies
    view: @scope.self, @role.admin
    edit: @scope.self, @role.admin

    fields User
      email
        read: @scope.self, @role.admin
        write: @scope.self, @role.admin

feature listing
  purpose "Seller listings with pricing and geo coordinates."

  uses account

  domain
    resource Listing
      seller: User required
      title: Text required
      price: Money required
      currency: Currency required
      location: GeoPoint required
      created_at: DateTime required

feature order
  purpose "Buyer order for a listing, including payment amount."

  uses account, listing

  domain
    resource Order
      buyer: User required
      listing: Listing required
      placed_at: DateTime required
      amount: Money required
      currency: Currency required
      payment_reference: Text optional

      lifecycle status
        state pending initial
        state paid
        state fulfilled terminal
        state cancelled terminal

        transition confirm_payment
          from pending
          to paid
          timestamps paid_at
          emits order_paid

        transition fulfill
          from paid
          to fulfilled
          timestamps fulfilled_at
          emits order_fulfilled

        transition cancel
          from pending, paid
          to cancelled
          timestamps cancelled_at
          emits order_cancelled

feature payment
  purpose "Generic payment gateway callback handling for orders."

  defaults
    policy_for webhooks: @actor.system

  uses order

  requires integration payment_gateway: PaymentGateway

  domain
    event payment_received
      order_id: ID
      external_reference: Text
      amount: Money
      currency: Currency

  webhook payment_callback
    path "/webhooks/payment"
    payload from webhook_events.payment_event
    verify hmac sha256
      secret env.PAYMENT_WEBHOOK_SECRET
      header "X-Signature"
    tenant_from payload.external_reference
    idempotency by payload.id
    handler "./webhooks/payment_callback.go"
    emits payment_received
