app MarketplaceMini
  uses
    account
    listing
    order
    payment

  packs
    marketplace from registry.packs.marketplace

  bindings
    marketplace.payment_gateway = integrations.payment_gateway
    payment.payment_gateway = integrations.payment_gateway

  targets
    backend go
    web react

  environments
    local
    production

  urls
    web local "http://localhost:3000"
    api local "http://localhost:3000"

  runtime
    unit api
      serves webhooks
      healthcheck "/healthz"

  deploy
    migrations before_deploy
    rollback on_failed_healthcheck
    strategy rolling
