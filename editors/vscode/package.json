{
  "name": "lazuli-vscode",
  "displayName": "Lazuli",
  "description": "Language support for Lazuli .lzi / .lzx files plus Lazurite.toml manifests. Bundles the Lazuli language server for diagnostics, hover, completion, snippets, and 3 distinct file icons.",
  "version": "0.1.0",
  "publisher": "lazuli",
  "license": "MIT",
  "icon": "icons/lazurite.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lazuli-lang/lazuli.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/lazuli-lang/lazuli/issues"
  },
  "homepage": "https://github.com/lazuli-lang/lazuli#readme",
  "keywords": [
    "lazuli",
    "lazurite",
    "lzi",
    "lzx",
    "dsl",
    "ai-first",
    "framework",
    "go",
    "typescript"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "Lazuli",
      "properties": {
        "lazuli.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to the lazuli executable used as the language server. When empty, the extension prefers the bundled binary, then falls back to `lazuli` on PATH. Set this to point at a custom build (e.g. `C:/Users/you/lazuli/target/release/lazuli.exe`)."
        },
        "lazuli.trace.server": {
          "type": "string",
          "scope": "window",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP messages between VS Code and the lazuli server."
        }
      }
    },
    "languages": [
      {
        "id": "lazuli-feature",
        "aliases": [
          "Lazuli Feature",
          "lzi"
        ],
        "extensions": [
          ".lzi"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/lzi.png",
          "dark": "./icons/lzi.png"
        }
      },
      {
        "id": "lazuli-experience",
        "aliases": [
          "Lazuli Experience",
          "lzx"
        ],
        "extensions": [
          ".lzx"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/lzx.png",
          "dark": "./icons/lzx.png"
        }
      },
      {
        "id": "lazurite-manifest",
        "aliases": [
          "Lazurite Manifest"
        ],
        "filenames": [
          "Lazurite.toml",
          "lazurite.toml"
        ],
        "icon": {
          "light": "./icons/lazurite.png",
          "dark": "./icons/lazurite.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "lazuli-feature",
        "scopeName": "source.lazuli",
        "path": "./syntaxes/lazuli.tmLanguage.json"
      },
      {
        "language": "lazuli-experience",
        "scopeName": "source.lazuli",
        "path": "./syntaxes/lazuli.tmLanguage.json"
      },
      {
        "language": "lazurite-manifest",
        "scopeName": "source.lazurite-toml",
        "path": "./syntaxes/lazurite-manifest.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "lazuli-feature",
        "path": "./snippets/lazuli.code-snippets"
      },
      {
        "language": "lazuli-experience",
        "path": "./snippets/lazuli.code-snippets"
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "scripts": {
    "package": "vsce package --target win32-x64",
    "bundle-server": "node scripts/bundle-server.js",
    "test:grammar:lazuli": "vscode-tmgrammar-snap -g ./syntaxes/lazuli.tmLanguage.json --updateSnapshot \"./tests/grammar/**/*.lzi\" \"./tests/grammar/**/*.lzx\"",
    "test:grammar:lazuli:check": "vscode-tmgrammar-snap -g ./syntaxes/lazuli.tmLanguage.json \"./tests/grammar/**/*.lzi\" \"./tests/grammar/**/*.lzx\"",
    "test:grammar:manifest": "vscode-tmgrammar-snap -g ./syntaxes/lazurite-manifest.tmLanguage.json -s source.lazurite-toml --updateSnapshot \"./tests/grammar/**/*.toml\"",
    "test:grammar:manifest:check": "vscode-tmgrammar-snap -g ./syntaxes/lazurite-manifest.tmLanguage.json -s source.lazurite-toml \"./tests/grammar/**/*.toml\"",
    "test:grammar": "npm run test:grammar:lazuli && npm run test:grammar:manifest",
    "test:grammar:gen": "cargo run --manifest-path ../../Cargo.toml -p xtask -- gen-tmlanguage",
    "test:grammar:gen:check": "cargo run --manifest-path ../../Cargo.toml -p xtask -- gen-tmlanguage --check",
    "test:grammar:check": "npm run test:grammar:gen:check && npm run test:grammar:lazuli:check && npm run test:grammar:manifest:check",
    "test:diagnostics": "cargo test --manifest-path ../../Cargo.toml -p lazuli_lsp --test typo_snapshot",
    "test:all": "npm run test:grammar:check && npm run test:diagnostics"
  }
}
