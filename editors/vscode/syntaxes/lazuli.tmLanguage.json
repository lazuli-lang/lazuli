{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lazuli",
  "scopeName": "source.lazuli",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#sections"
    },
    {
      "include": "#typedLines"
    },
    {
      "include": "#statements"
    },
    {
      "include": "#references"
    },
    {
      "include": "#types"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.lazuli",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lazuli",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lazuli",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "^\\s*\\b(feature)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.declaration.structural.lazuli"
            },
            "2": {
              "name": "entity.name.type.feature.lazuli"
            }
          }
        },
        {
          "match": "^\\s*\\b(app)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.declaration.structural.lazuli"
            },
            "2": {
              "name": "entity.name.type.app.lazuli"
            }
          }
        },
        {
          "match": "^\\s*\\b(workspace)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.declaration.structural.lazuli"
            },
            "2": {
              "name": "entity.name.type.workspace.lazuli"
            }
          }
        },
        {
          "name": "keyword.control.declaration.structural.lazuli",
          "match": "^\\s*\\b(registry|profile)\\b"
        },
        {
          "match": "^\\s*\\b(plan)\\s+([a-z_][a-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.declaration.structural.lazuli"
            },
            "2": {
              "name": "entity.name.type.plan.lazuli"
            }
          }
        },
        {
          "name": "keyword.other.plan-and-gate.lazuli",
          "match": "\\b(gate|behind|quota|features|limits|trial|then|unlimited|subscription)\\b"
        },
        {
          "name": "keyword.operator.plan-and-gate.lazuli",
          "match": "\\b(plan\\.(?:feature|limit))\\b"
        },
        {
          "match": "^\\s*\\b(contract)\\s+([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.declaration.structural.lazuli"
            },
            "2": {
              "name": "entity.name.type.contract.lazuli"
            }
          }
        },
        {
          "match": "^\\s*\\b(experience)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.declaration.structural.lazuli"
            },
            "2": {
              "name": "entity.name.type.experience.lazuli"
            }
          }
        },
        {
          "match": "^\\b(route)\\s+([A-Za-z_][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.declaration.structural.lazuli"
            },
            "2": {
              "name": "entity.name.function.route.lazuli"
            }
          }
        },
        {
          "match": "^\\s*\\b(resource|record)\\s+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.declaration.structural.lazuli"
            },
            "2": {
              "name": "entity.name.type.resource.lazuli"
            }
          }
        },
        {
          "match": "^\\s*\\b(enum)\\s+([A-Z][A-Za-z0-9_]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.declaration.structural.lazuli"
            },
            "2": {
              "name": "entity.name.type.enum.lazuli"
            }
          }
        },
        {
          "match": "^\\s*\\b(query(?:\\.(?:list|lookup|sql))?|command|api|operation|workflow|view|event(?:\\.trace)?|event_group|events|webhook|job|auth|extends|agent|notification|poller|report)\\s+([A-Za-z_][A-Za-z0-9_\\.*]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.declaration.structural.lazuli"
            },
            "2": {
              "name": "entity.name.function.named-block.lazuli"
            }
          }
        },
        {
          "comment": "RBAC catalog vocab — top-level `permission <id>` / `role <name>` (rbac-catalog-vocab.md).",
          "match": "^\\s*\\b(permission|role)\\s+([a-z][a-z0-9_:]*)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.declaration.structural.lazuli"
            },
            "2": {
              "name": "entity.name.label.rbac.lazuli"
            }
          }
        },
        {
          "match": "\\b(surface)\\s+([a-z_][a-z0-9_]*)(?:\\s+([a-z_][a-z0-9_]*))?",
          "captures": {
            "1": {
              "name": "keyword.section.layer.lazuli"
            },
            "2": {
              "name": "entity.name.label.surface-target.lazuli"
            },
            "3": {
              "name": "entity.name.label.surface-area.lazuli"
            }
          }
        },
        {
          "name": "keyword.control.declaration.structural.lazuli",
          "match": "\\b(auth)\\b"
        },
        {
          "match": "\\b(rule)\\s+(\"[^\"]+\")",
          "captures": {
            "1": {
              "name": "keyword.control.declaration.structural.lazuli"
            },
            "2": {
              "name": "string.quoted.double.rule-name.lazuli"
            }
          }
        },
        {
          "match": "\\b(escape_route)\\s+(\"[^\"]+\")",
          "captures": {
            "1": {
              "name": "keyword.control.declaration.structural.lazuli"
            },
            "2": {
              "name": "string.quoted.double.route.lazuli"
            }
          }
        }
      ]
    },
    "sections": {
      "patterns": [
        {
          "name": "keyword.section.layer.lazuli",
          "match": "\\b(domain|surface|extensions)\\b"
        },
        {
          "name": "keyword.section.lazuli",
          "match": "\\b(defaults|non_goals|delegated_to|out_of_scope|constraints|policies|errors|params|route|key|scope|filters|cells|payload|apps|shared_registry|boundaries|gateway|targets|environments|urls|env|group|integrations|bindings|packs|capabilities|architecture|services|communication|runtime|deploy|encryption|rotation|cursor|states|retry_quirk)\\b"
        },
        {
          "comment": "L0 #8 — poller statement keywords (poller-vocab.md §3).",
          "name": "keyword.control.statement.poller.lazuli",
          "match": "\\b(eligible_when|max_attempts|backoff|terminal_status_field|terminal_result_field|tick|resolve|fixed|linear|exponential|gender_flip_once)\\b"
        },
        {
          "comment": "RBAC catalog vocab — role-body + policy-predicate keywords (rbac-catalog-vocab.md).",
          "name": "keyword.control.statement.rbac.lazuli",
          "match": "\\b(inherits|grants|grants_all|has_role|has_permission)\\b"
        }
      ]
    },
    "typedLines": {
      "patterns": [
        {
          "match": "\\b(client|fn|hook|validator|adapter|query_modifier|server|block)\\s+([A-Za-z_][A-Za-z0-9_]*)(:)",
          "captures": {
            "1": {
              "name": "entity.name.function.statement.extension.lazuli"
            },
            "2": {
              "name": "entity.name.function.extension-point.lazuli"
            },
            "3": {
              "name": "punctuation.separator.type.lazuli"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_\\.]*)(:)\\s*(\"[^\"]+\")",
          "captures": {
            "1": {
              "name": "variable.other.dictionary-key.lazuli"
            },
            "2": {
              "name": "punctuation.separator.key-value.lazuli"
            },
            "3": {
              "name": "string.quoted.double.lazuli"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(:)\\s*(@(?:semantic|cap)\\.[A-Z][A-Za-z0-9_]*(?:\\[\\])?|[A-Z][A-Za-z0-9_]*(?:\\[\\])?|many\\s+[A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "variable.other.field.lazuli"
            },
            "2": {
              "name": "punctuation.separator.type.lazuli"
            },
            "3": {
              "name": "support.type.domain.lazuli"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s+(previously)\\s+(?:(migrated|alias)\\s+)?([A-Za-z_][A-Za-z0-9_]*)(:)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.function.transition.lazuli"
            },
            "2": {
              "name": "storage.modifier.lazuli"
            },
            "3": {
              "name": "storage.modifier.lazuli"
            },
            "4": {
              "name": "entity.name.function.transition.previous.lazuli"
            },
            "5": {
              "name": "punctuation.separator.key-value.lazuli"
            },
            "6": {
              "name": "constant.other.symbolic.lazuli"
            },
            "7": {
              "name": "keyword.operator.transition.lazuli"
            },
            "8": {
              "name": "constant.other.symbolic.lazuli"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(:)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(->)\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "entity.name.function.transition.lazuli"
            },
            "2": {
              "name": "punctuation.separator.key-value.lazuli"
            },
            "3": {
              "name": "constant.other.symbolic.lazuli"
            },
            "4": {
              "name": "keyword.operator.transition.lazuli"
            },
            "5": {
              "name": "constant.other.symbolic.lazuli"
            }
          }
        }
      ]
    },
    "statements": {
      "patterns": [
        {
          "name": "entity.name.function.statement.metadata.lazuli",
          "match": "\\b(title|version|default_locale|default_timezone|auth_failed_redirect|not_found|purpose|compatibility|import|transport|context|uses|imports|target|targets|path|to|params|surface|audience|lazy|prerender|at|external|contract|tenant|tenant_from|reason|verify|secret|header|idempotency|trigger|schedule|queue|unit|mode|service_ready|enforce_service_boundaries|service|owns|exposes|publishes|consumes|internal|async|sync|propagate|timeout|serves|runs|healthcheck|readiness|migrations|migration_lock|destructive_migrations|rollback|topology|environment|environments|retry|backoff|handler|returns|identity|password|oauth|mfa|sessions|ttl|refresh|hash|algorithm|adapter|credentials|data_classification|enroll|rate_limit|extensible_by|tests|topic|provides|model|prompt|tools|safety|stream|temperature|max_tokens|top_p|seed|locale|supported|fallback|tags|namespace|deprecated|since|sunset|replacement|translation|catalog|plural|locale_negotiate|strategy|source|digest|throttle|every|group_by|max_size|template_strategy|max_per|per_recipient|per_channel|burst)\\b"
        },
        {
          "name": "entity.name.function.statement.resource.lazuli",
          "match": "\\b(tenancy|soft_delete|timestamps|no_timestamps|validate|validates|unique|index|on_delete|record|derived|has_many|inverse)\\b"
        },
        {
          "name": "entity.name.function.statement.query.lazuli",
          "match": "\\b(returns|order|paginate|sql|modifier|cache|key|ttl|search|over|mode)\\b"
        },
        {
          "name": "entity.name.function.statement.command.lazuli",
          "match": "\\b(creates|updates|deletes|input|route|let|target|policy|policy_for|requires|integration|calls|emits|invalidates|returns|on|from|permits|forbids|allows|deny|denies|accepted|rejected|as|error|status|expose|write_window|audit)\\b"
        },
        {
          "name": "entity.name.function.statement.view.lazuli",
          "match": "\\b(source|submit|columns|fields|sections|actions|opens|search|filter|block|slot|platforms|anchor|item|title|badges|by|panel)\\b"
        },
        {
          "name": "entity.name.function.statement.rule.lazuli",
          "match": "\\b(forbid|deny|where|message)\\b"
        },
        {
          "name": "entity.name.function.statement.policy.lazuli",
          "match": "\\b(read|write|create|update|delete|import|global_read|login|system)\\b"
        },
        {
          "name": "support.function.type-constructor.lazuli",
          "match": "\\b(many|list_of|ref)\\b"
        }
      ]
    },
    "references": {
      "patterns": [
        {
          "name": "entity.name.reference.package.lazuli",
          "match": "@(?:runtime|plugin)/[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*"
        },
        {
          "name": "entity.name.reference.semantic.lazuli",
          "match": "@?\\b[a-z_][a-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+\\b"
        },
        {
          "name": "entity.name.reference.model-path.lazuli",
          "match": "\\b[A-Z][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)+\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.lazuli",
          "match": "(?:@(?:semantic|cap|pii|key)\\.)?\\b(ID|Text|String|Email|Url|Boolean|Bool|Int|Integer|Float|Decimal|Numeric|Money|Date|DateTime|Json|JSON|File|Secret|Hashed|Encrypted|E2ee|Token)\\b"
        },
        {
          "name": "support.type.ui.lazuli",
          "match": "\\b(Form|AuthForm|Mutation|Transition|Table|List|CardList|Screen|SidePanel|Sheet)\\b"
        },
        {
          "name": "support.type.extension.lazuli",
          "match": "\\b(Cell|Block|CellRenderer|Hook|Function|Validator|QueryModifier|WorkflowEffect|PageBlock|ViewBlock|FormField|IntegrationAdapter)\\b"
        },
        {
          "name": "support.type.domain.lazuli",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.modifier.lazuli",
          "match": "\\b(required|optional|default|readonly|raw|override|previously|migrated|alias|per|at|from|provides|cascade|restrict|nullify|by)\\b"
        },
        {
          "name": "keyword.operator.logical.lazuli",
          "match": "\\b(and|or|not|AND|OR|has|when)\\b"
        },
        {
          "name": "keyword.operator.predicate.lazuli",
          "match": "\\b(has|in|exists)\\b"
        },
        {
          "name": "constant.other.direction.lazuli",
          "match": "\\b(asc|desc)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.lazuli",
          "match": "\\b(true|false|nil|null)\\b"
        },
        {
          "name": "constant.numeric.lazuli",
          "match": "\\b[0-9]+(?:\\.[0-9]+)?\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.transition.lazuli",
          "match": "->"
        },
        {
          "name": "keyword.operator.union.lazuli",
          "match": "\\|"
        },
        {
          "name": "keyword.operator.comparison.lazuli",
          "match": "==|!=|<=|>=|="
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.definition.generic.begin.lazuli",
          "match": "\\["
        },
        {
          "name": "punctuation.definition.generic.end.lazuli",
          "match": "\\]"
        },
        {
          "name": "punctuation.section.parens.begin.lazuli",
          "match": "\\("
        },
        {
          "name": "punctuation.section.parens.end.lazuli",
          "match": "\\)"
        },
        {
          "name": "punctuation.separator.comma.lazuli",
          "match": ","
        },
        {
          "name": "punctuation.separator.key-value.lazuli",
          "match": ":"
        },
        {
          "name": "punctuation.accessor.lazuli",
          "match": "\\."
        }
      ]
    }
  }
}
