{
  "name": "@lazuli/runtime",
  "version": "0.0.0",
  "private": true,
  "description": "Lazuli universal runtime — typed client + React hooks (TanStack Query). One package serves web and React Native via the exports map's `react-native` condition; see docs/proposals/mobile-target.md §3.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./react": {
      "types": "./src/react.ts",
      "react-native": "./src/react.native.ts",
      "default": "./src/react.web.ts"
    },
    "./react/tanstack": {
      "types": "./src/tanstack-adapter.ts",
      "import": "./src/tanstack-adapter.ts",
      "default": "./src/tanstack-adapter.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "tsc": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "search-query-parser": "^1.6.0"
  },
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.23.0",
    "@tanstack/react-query": ">=5.0.0",
    "@tanstack/react-router": ">=1.0.0",
    "react": ">=18.0.0",
    "react-native": ">=0.74.0"
  },
  "peerDependenciesMeta": {
    "@react-native-async-storage/async-storage": { "optional": true },
    "@tanstack/react-query": { "optional": true },
    "@tanstack/react-router": { "optional": true },
    "react": { "optional": true },
    "react-native": { "optional": true }
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.59.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "happy-dom": "^15.11.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
