# Doctor fixture - MISSING-POLICY-ON-QUERY-001 happy path.
# Every query authors an explicit policy.

feature catalog
  domain
    query.list list_products
      policy @policy.authenticated

    query.lookup by_id by id: ID
      policy @policy.authenticated

    query.sql search_products
      policy @policy.authenticated
      returns Text
      sql "./queries/search_products.sql"
