# Doctor fixture — ERR-VOCAB-EXPOSE-5XX-MESSAGE (error).
# `expose client 5xx message` exposes server-internal messages on 5xx
# responses. The runtime force-hides regardless; the analyzer flags the
# authoring as a mistake (the author's expectation that the message
# would reach the client never holds).

app AcmeApp
  title "Acme"
  version "0.1.0"
  targets
    backend go
  environments
    local
  locale
    default "pt-BR"
    supported "pt-BR"

feature customer
  domain
    resource Customer
      id: ID required

  errors
    default hide
    expose client 4xx message, code
    expose client 5xx code, message
