# Doctor fixture — ERR-VOCAB-CODE-UNKNOWN (error).
# `errors blah_error message @translation.X` uses an error code outside
# the closed catalog of 8 framework codes.

app AcmeApp
  title "Acme"
  version "0.1.0"
  targets
    backend go
  environments
    local
  locale
    default "pt-BR"
    supported "pt-BR"

feature customer
  domain
    resource Customer
      id: ID required

  errors
    default hide
    expose client 4xx message, code
    expose client 5xx code

    blah_error message @translation.signin_required

  translation
    catalog "./i18n/customer.<locale>.json"

    key signin_required
      pt-BR "Entre na sua conta"
