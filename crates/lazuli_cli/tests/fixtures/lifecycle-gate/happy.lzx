experience host
  view host_home
    policy @policy.authenticated
    # requires_lifecycle Host = complete
    # on_lifecycle_pending @resume host_onboarding

  view host_onboarding_intermediation
    policy @policy.authenticated
    # requires_lifecycle Host = intermediation_terms_pending
    # on_lifecycle_pending @resume host_onboarding

  view host_onboarding_basic_details
    policy @policy.authenticated
    # requires_lifecycle Host = basic_details_pending
    # on_lifecycle_pending @resume host_onboarding

  view host_onboarding_address
    policy @policy.authenticated
    # requires_lifecycle Host = address_pending
    # on_lifecycle_pending @resume host_onboarding

  view host_onboarding_languages
    policy @policy.authenticated
    # requires_lifecycle Host = languages_pending
    # on_lifecycle_pending @resume host_onboarding

# resume host_onboarding
#   source query.lookup my_host
#   none -> view host_onboarding_intermediation
#   intermediation_terms_pending -> view host_onboarding_intermediation
#   basic_details_pending -> view host_onboarding_basic_details
#   address_pending -> view host_onboarding_address
#   languages_pending -> view host_onboarding_languages
#   complete -> view host_home
