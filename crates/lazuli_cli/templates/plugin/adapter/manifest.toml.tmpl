# Plugin-catalog v1 metadata. Authoritative identity lives under
# `[plugin]`; the top-level scalars below are legacy contract metadata
# (status / version / implements) consumed by other tooling.
version = "0.1.0"
status = "draft"
maintainer = "you@example.com"
# The framework bucket interface this adapter satisfies. Must be a KNOWN
# bucket interface — `lazuli plugin verify`'s L3 link and the
# `PLUGIN-CONTRACT-001` doctor check both validate it against the closed
# catalog. The scaffold ships `payments.PaymentGateway` so a fresh adapter
# verifies GREEN out of the box; swap it for the bucket you actually
# implement (`storage.ObjectStore`, `maps.Geocoder`,
# `notifications.EmailSender`, `auth/social.Provider`, …) and update the
# `var _ <Interface> = (*Adapter)(nil)` assertion in adapter.go to match.
implements = ["payments.PaymentGateway"]

[plugin]
name = "{{name}}"
namespace = "{{namespace}}"
go_module = "{{module}}"
description = "Adapter plugin {{name}} — binds a Go interface + declares an env contract."

[binds]
# Keep in sync with `implements` above. Blessed short form is
# `<bucket>.<Interface>`; verify normalises a fully-qualified
# `lazuli.dev/runtime/lazuli/<bucket>.<Interface>` to the same key.
interface = "payments.PaymentGateway"
methods = ["Do"]

[env]
required = []
optional = []
