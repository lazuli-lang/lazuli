# Doctor fixture — ERR-VOCAB-003 (warning).
# `command update` is gated by a local policy `@policy.update` which
# itself has no `when_denied`. The feature also declares no
# `errors policy_denied message @translation.<key>` catch-all. On
# policy_denied, the client sees the framework's built-in localized
# message — fine for prototypes, but not domain-specific. Doctor warns.
#
# Note: this is distinct from ERR-VOCAB-001 (which fires when NO
# policy in the block has `when_denied`); ERR-VOCAB-003 is a per-
# command nudge. Here both happen to fire because there's only one
# policy — the assertion targets ERR-VOCAB-003 specifically and tolerates
# ERR-VOCAB-001 as a sibling warning.

app AcmeApp
  title "Acme"
  version "0.1.0"
  targets
    backend go
  environments
    local
  locale
    default "pt-BR"
    supported "pt-BR"

feature customer
  domain
    resource Customer
      id: ID required

  policies
    update: @role.admin

  command update
    policy @policy.update
    updates Customer
