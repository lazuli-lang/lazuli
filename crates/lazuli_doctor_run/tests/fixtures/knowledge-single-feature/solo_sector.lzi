# Doctor fixture — POSITIVE case for VOCAB-KNOWLEDGE-SINGLE-FEATURE-001.
# Two features in one package; only ONE (`alpha`) declares
# `knowledge solo-sector`. The sector is therefore declared by exactly one
# feature → the package-level rule fires once for `solo-sector`, anchored at
# `alpha`. (`beta` declares no knowledge sector.)

app AcmeApp
  title "Acme"
  version "0.1.0"
  targets
    backend go
  environments
    local

feature alpha
  purpose "Alpha capability."
  knowledge solo-sector
  domain
    resource Alpha
      id: ID required

feature beta
  purpose "Beta capability."
  domain
    resource Beta
      id: ID required
